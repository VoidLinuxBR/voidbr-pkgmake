pkgname=cosmic-settings
pkgver=1.10.0
pkgrel=1
epoch=1
pkgdesc='The settings application for the COSMIC desktop environment'
arch=(x86_64)
url=https://github.com/pop-os/cosmic-settings
license=(GPL-3.0-only)
groups=(cosmic)
# NOTE: depends original (arch): accountsservice adw-gtk-theme cosmic-icon-theme cosmic-randr fontconfig libgcc glibc iso-codes libinput libpipewire libpulse libxkbcommon networkmanager nm-connection-editor pipewire-pulse systemd-libs ttf-opensans wayland
depends=(
	'accountsservice'
	'adw-gtk-theme'
	'cosmic-icon-theme'
	'cosmic-randr'
	'fontconfig'
	'libgcc'
	'glibc'
	'iso-codes'
	'libinput'
	'libpipewire'
	'libpulseaudio'
	'libxkbcommon'
	'NetworkManager'
	'network-manager-applet'
	'pipewire'
	'ttf-opensans'
	'wayland'
)
# NOTE: makedepends original (arch): cargo clang git just mold
makedepends=(
	'accountsservice-devel'
	'fontconfig-devel'
	'libinput-devel'
	'pulseaudio-devel'
	'libxkbcommon-devel'
	'NetworkManager-devel'
	'pipewire-devel'
	'wayland-devel'
	'cargo'
	'clang'
	'clang21-devel' # VoidBR: libclang.so (bindgen/clang-sys); no Arch vem no clang
	'git'
	'just'
	'mold'
)
optdepends=('power-profiles-daemon: power profiles support')
source=(git+https://github.com/pop-os/cosmic-settings.git#tag=epoch-${pkgver})
b2sums=('6cd3d1a62796f03016bb6c1c6354f93a0f5878668c45903101f4786de2934a6f2288241c85e64a1df4eb584bfea4ebfa0e99d4e4e5e065c57a743577b881b309')

prepare() {
	cd cosmic-settings
	cargo fetch --locked
}

build() {
	cd cosmic-settings
	RUSTFLAGS+=" -C link-arg=-fuse-ld=mold"
	just build-release --frozen
}

package() {
	cd cosmic-settings
	just rootdir="${pkgdir}" install
}

# vim: ts=2 sw=2 et:

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
