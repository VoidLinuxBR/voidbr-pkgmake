#!/usr/bin/env bash
# NOTE: Imported from Arch Linux/AUR
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>
# Maintainer: D. Can Celasun <can[at]dcc[dot]im>

pkgname=visual-studio-code-bin
_pkgname=visual-studio-code
pkgver=1.141.2
pkgrel=1
pkgdesc="Visual Studio Code (vscode): Editor for building and debugging modern web and cloud applications (official binary version)"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://code.visualstudio.com/"
license=('custom: commercial')
provides=('code' 'vscode')
conflicts=('code')
# Upstream has signature verification for extensions and stripping breaks it
# See https://github.com/microsoft/vscode/issues/223455#issuecomment-2610001754
options=(!strip)
# lsof: needed for terminal splitting, see https://github.com/Microsoft/vscode/issues/62991
# xdg-utils: needed for opening web links with xdg-open
# nomes de pacotes do Void (o Arch usa gtk3, gcc-libs, libxss)
depends=(libxkbfile gnupg gtk+3 libsecret nss libgcc libnotify libXScrnSaver glibc lsof shared-mime-info xdg-utils alsa-lib)
makedepends=(bsdtar)
optdepends=('glib: Needed for move to trash functionality'
	'libdbusmenu-glib: Needed for KDE global menu'
	'gnome-keyring: Needed for settings sync'
	# See https://code.visualstudio.com/docs/agents/run/agent-sandboxing#_check-platform-availability
	'bubblewrap: Agent host sandboxing' 'socat: Agent host sandboxing'
)
# pkgmake não usa source_<arch>: escolhe o .deb pela arquitetura da máquina
case "$(uname -m)" in
x86_64) _debarch=x64 _debname=amd64 ;;
aarch64) _debarch=arm64 _debname=arm64 ;;
armv7l) _debarch=armhf _debname=armhf ;;
esac
source=(${_pkgname}-bin.sh
	"code_${pkgver}_${_debname}.deb::https://update.code.visualstudio.com/${pkgver}/linux-deb-${_debarch}/stable")
sha256sums=('bd0d9edf69283ebdf4e73e0a7b168d2fcf50acbd01f63674cad93ed4fe42fdad')
sha256sums_x86_64=('d09b25a39b41b35e514b276ec551f73df4fea9197a14b4f365ca72fb139211cc')
sha256sums_aarch64=('12b0b8064f85a90772fa4daa62515f3ac0c7e3a19ab0ba37bfb8fea45f8be147')
sha256sums_armv7h=('8dc5c6040a622a63f38b6383013580ea6cc7085d9fbfd482f6953d02b160e4d7')

package() {
	bsdtar -xf data.tar.xz -C "${pkgdir}/"

	install -d "${pkgdir}/usr/bin"
	install -d "${pkgdir}/usr/share/licenses/${pkgname}"

	ln -s /usr/share/code/resources/app/LICENSE.rtf \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.rtf"

	# Launcher
	install -m755 "${srcdir}/${_pkgname}-bin.sh" "${pkgdir}/usr/bin/code"

	# Fix the desktop entries
	sed -i \
		-e 's/^\(Exec=\)[^ ]*/\1code/g' \
		"${pkgdir}"/usr/share/applications/*.desktop

	# setuid on chrome-sandbox
	# Comment out if using a kernel without user namespaces, like linux-hardened
	chmod u-s "${pkgdir}/usr/share/code/chrome-sandbox"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
	log "Flags personalizadas vão em: ~/.config/code-flags.conf"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
	log "Flags personalizadas vão em: ~/.config/code-flags.conf"
}
