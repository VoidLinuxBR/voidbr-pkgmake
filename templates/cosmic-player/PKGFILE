pkgname=cosmic-player
pkgver=1.10.0
pkgrel=1
epoch=1
pkgdesc="WIP COSMIC media player"
arch=(x86_64)
url="https://github.com/pop-os/cosmic-player"
license=(GPL-3.0-or-later)
groups=(cosmic)
# NOTE: depends original (arch): libgcc glib2 glibc gst-plugins-base gst-plugins-base-libs gst-plugins-good gstreamer libxkbcommon
depends=(
	'libgcc'
	'glib'
	'glibc'
	'gst-plugins-base1'
	'gst-plugins-good1'
	'gstreamer1'
	'libxkbcommon'
)
# NOTE: makedepends original (arch): cargo clang git just lld
makedepends=(
	'glib-devel'
	'gst-plugins-base1-devel'
	'gstreamer1-devel'
	'libxkbcommon-devel'
	'cargo'
	'clang'
	'clang21-devel' # VoidBR: libclang.so (bindgen/clang-sys); no Arch vem no clang
	'git'
	'just'
	'lld'
)
source=(git+https://github.com/pop-os/cosmic-player.git#tag=epoch-${pkgver})
sha256sums=('f079eeeef991af76b632d6ebb3bb82ff62dec33b467f159d43bdf21462432ab9')

prepare() {
	cd "$pkgname"
	cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
	cd "$pkgname"

	RUSTFLAGS+=" -C link-arg=-fuse-ld=lld"

	# use nice to build with lower priority
	nice just build-release --frozen
}

package() {
	cd "$pkgname"
	just rootdir="$pkgdir" install
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
