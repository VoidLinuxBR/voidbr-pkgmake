#!/usr/bin/env bash
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=brave-bin
pkgver=1.99.57
pkgrel=1
epoch=1
pkgdesc='Web browser that blocks ads and trackers by default (binary release)'
arch=(x86_64 aarch64)
url=https://brave.com
license=(MPL-2.0 BSD-3-Clause custom:chromium)
depends=(alsa-lib at-spi2-atk at-spi2-core atk cairo dbus-libs eudev-libudev expat glib gtk+3
	libcups libgbm libX11 libXcomposite libXdamage libXext libXfixes libXrandr libxcb libxkbcommon
	nspr nss pango liberation-fonts-ttf xdg-utils)
makedepends=(unzip)
options=('!emptydirs' '!strip')

case "${CARCH:-$(uname -m)}" in
aarch64)
	_arch=arm64
	_sha256='1bdad41be7adc541fb82b5265ed1e8c3d4a36c964ea1ad9254f9f64305285473'
	;;
*)
	_arch=amd64
	_sha256='734bd9e1d24bc0a94c03b0a43845107dd8a29f572c652023cf7177f5fc3a5f38'
	;;
esac
_zip="brave-browser-${pkgver}-linux-${_arch}.zip"

source=("$pkgname.sh"
	'brave-browser.desktop'
	"${_zip}::https://github.com/brave/brave-browser/releases/download/v${pkgver}/${_zip}")
sha256sums=('SKIP'
	'SKIP'
	"$_sha256")

package() {
	# o zip não tem pasta raiz: extrai direto no destino (evita levar o .zip e os
	# arquivos locais do $srcdir para dentro do pacote)
	install -dm0755 "$pkgdir/opt/$pkgname"
	unzip -q -o "$srcdir/$_zip" -d "$pkgdir/opt/$pkgname"

	# arquivos do Debian/Ubuntu sem uso no Void
	rm -rf "$pkgdir/opt/$pkgname/cron" "$pkgdir/opt/$pkgname/apparmor.d"

	# allow firejail users to get the suid sandbox working
	chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

	# launcher e .desktop
	install -Dm0755 "$srcdir/$pkgname.sh" "$pkgdir/usr/bin/brave"
	install -Dm0644 -t "$pkgdir/usr/share/applications/" "$srcdir/brave-browser.desktop"

	# ícones
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256; do
		install -Dm0644 "$pkgdir/opt/$pkgname/product_logo_${size/x*/}.png" \
			"$pkgdir/usr/share/icons/hicolor/$size/apps/brave-desktop.png"
	done

	# licença
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$pkgdir/opt/$pkgname/LICENSE"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
	log "Flags personalizadas devem ir em: ~/.config/brave-flags.conf"
	log "O launcher se chama: 'brave'"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
