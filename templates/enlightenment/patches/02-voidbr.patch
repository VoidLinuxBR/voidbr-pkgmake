+
+/* --- VM: refaz a saida de video depois de reiniciar ---------------------
+ * Em VM (QEMU/virtio, VirtualBox, VMware) a imagem do Xorg pode parar de
+ * chegar a tela depois que o E reinicia (troca de perfil): o Xorg tem a
+ * imagem, mas a saida "Virtual-N" nao atualiza mais. Desligar e religar a
+ * saida (o mesmo que xrandr --off / --auto) refaz a ligacao. So em saidas
+ * virtuais (ou com VOIDBR_SCREEN_REFRESH=1) e so depois de um reinicio.
+ */
+#ifndef HAVE_WAYLAND_ONLY
+static Ecore_Timer *_vm_timer = NULL;
+
+static Eina_Bool
+_cb_vm_screen_refresh(void *data EINA_UNUSED)
+{
+   Ecore_X_Randr_Crtc *crtcs;
+   Ecore_X_Window root;
+   Eina_Bool force = !!getenv("VOIDBR_SCREEN_REFRESH");
+   int i, n = 0;
+
+   _vm_timer = NULL;
+   if ((!e_comp) || (e_comp->comp_type != E_PIXMAP_TYPE_X)) return EINA_FALSE;
+   root = e_comp->root;
+   crtcs = ecore_x_randr_crtcs_get(root, &n);
+   if (!crtcs) return EINA_FALSE;
+   for (i = 0; i < n; i++)
+     {
+        Ecore_X_Randr_Crtc_Info *info;
+        Eina_Bool virt;
+        char *name;
+
+        info = ecore_x_randr_crtc_info_get(root, crtcs[i]);
+        if (!info) continue;
+        if ((info->mode) && (info->noutput > 0))
+          {
+             name = ecore_x_randr_output_name_get(root, info->outputs[0], NULL);
+             virt = force || ((name) && (!strncmp(name, "Virtual", 7)));
+             free(name);
+             if (virt)
+               {
+                  ecore_x_randr_crtc_settings_set(root, crtcs[i], NULL, 0, 0, 0, 0,
+                                                  ECORE_X_RANDR_ORIENTATION_ROT_0);
+                  ecore_x_sync();
+                  ecore_x_randr_crtc_settings_set(root, crtcs[i], info->outputs,
+                                                  info->noutput, info->x, info->y,
+                                                  info->mode, info->rotation);
+                  ecore_x_sync();
+               }
+          }
+        ecore_x_randr_crtc_info_free(info);
+     }
+   free(crtcs);
+   return EINA_FALSE;
+}
+#endif
+
+E_API void *
+e_modapi_init(E_Module *m)
+{
+   st.module = m;
+   st.wifi = st.wifi_radio = st.bt = st.vol = st.bat = -1;
+   _read_sys();
+   E_LIST_HANDLER_APPEND(st.handlers, ECORE_EXE_EVENT_DATA, _cb_exe_data, NULL);
+   E_LIST_HANDLER_APPEND(st.handlers, E_EVENT_CLIENT_FOCUS_IN, _cb_client, NULL);
+   E_LIST_HANDLER_APPEND(st.handlers, E_EVENT_CLIENT_FOCUS_OUT, _cb_client, NULL);
+   E_LIST_HANDLER_APPEND(st.handlers, E_EVENT_CLIENT_REMOVE, _cb_client, NULL);
+   E_LIST_HANDLER_APPEND(st.handlers, E_EVENT_CLIENT_PROPERTY, _cb_client, NULL);
+   e_gadcon_provider_register(&_class_status);
+   e_gadcon_provider_register(&_class_title);
+   st.poll = ecore_timer_loop_add(3.0, _cb_poll, NULL);
+   _query_all(EINA_TRUE);
+#ifndef HAVE_WAYLAND_ONLY
+   /* E_RESTART so existe quando o E foi reiniciado (nao no login) */
+   if (getenv("E_RESTART"))
+     _vm_timer = ecore_timer_loop_add(1.0, _cb_vm_screen_refresh, NULL);
+#endif
+   return m;
+}
+
+E_API int
+e_modapi_shutdown(E_Module *m EINA_UNUSED)
+{
+   e_gadcon_provider_unregister(&_class_title);
+   e_gadcon_provider_unregister(&_class_status);
+   E_FREE_LIST(st.handlers, ecore_event_handler_del);
+   E_FREE_FUNC(st.poll, ecore_timer_del);
+   E_FREE_FUNC(st.refresh, ecore_timer_del);
+#ifndef HAVE_WAYLAND_ONLY
+   E_FREE_FUNC(_vm_timer, ecore_timer_del);
+#endif
+   st.module = NULL;
+   return 1;
+}
+
+E_API int
+e_modapi_save(E_Module *m EINA_UNUSED)
+{
+   return 1;
+}
