+static void
+_popup_del(Status *s)
+{
+   E_FREE_FUNC(s->popup, e_object_del);
+}
+
+static void
+_popup_new(Status *s)
+{
+   static const char *cards[CARD_LAST] = { "wifi", "bluetooth", "tiling", "dnd", "shot", "tweaks" };
+   Evas_Object *box, *tb, *o;
+   const struct passwd *pw;
+   char buf[256], ini[8];
+   E_Zone *zone;
+   int i;
+
+   if (s->popup) return;
+   s->popup = e_gadcon_popup_new(s->gcc, 0);
+   if (!s->popup) return;
+   zone = s->gcc->gadcon->zone;
+
+   box = _track(&s->o_box, elm_box_add(e_comp->elm));
+   elm_box_padding_set(box, 0, 12);
+   elm_box_homogeneous_set(box, EINA_FALSE);
+
+   /* topo: avatar com as iniciais, nome, tempo ligado e configurações */
+   o = _track(&s->o_header, _edje(e_comp->evas, THEME_GROUP("header")));
+   if (o)
+     {
+        pw = getpwuid(getuid());
+        buf[0] = 0;
+        if (pw && pw->pw_gecos && pw->pw_gecos[0])
+          {
+             eina_strlcpy(buf, pw->pw_gecos, sizeof(buf));
+             if (strchr(buf, ',')) *strchr(buf, ',') = 0;
+          }
+        if (!buf[0] && pw) eina_strlcpy(buf, pw->pw_name, sizeof(buf));
+        edje_object_part_text_set(o, "e.text.name", buf);
+        /* iniciais: primeira letra do primeiro e do último nome */
+        ini[0] = 0;
+        if (buf[0])
+          {
+             char *last = strrchr(buf, ' ');
+             snprintf(ini, sizeof(ini), "%c%c", toupper((unsigned char)buf[0]),
+                      (last && last[1]) ? toupper((unsigned char)last[1]) : 0);
+          }
+        edje_object_part_text_set(o, "e.text.initials", ini);
+        edje_object_part_swallow(o, "e.swallow.button", _track(&s->o_settings, _button_add(s, "settings")));
+        _swallows_owned(o, _parts_header);
+        _min_hint(o);
+        evas_object_size_hint_align_set(o, EVAS_HINT_FILL, 0.5);
+        evas_object_show(o);
+        elm_box_pack_end(box, o);
+     }
+
+   /* cartões, 2 por linha */
+   tb = _track(&s->o_table, elm_table_add(e_comp->elm));
+   elm_table_padding_set(tb, 10, 10);
+   elm_table_homogeneous_set(tb, EINA_TRUE);
+   for (i = 0; i < CARD_LAST; i++)
+     {
+        snprintf(buf, sizeof(buf), THEME_GROUP("card/%s"), cards[i]);
+        o = _track(&s->o_card[i], _edje(e_comp->evas, buf));
+        if (!o) continue;
+        evas_object_data_set(o, "voidbr_card", (void *)(intptr_t)i);
+        edje_object_signal_callback_add(o, "e,action,click", "e", _cb_card, s);
+        _min_hint(o);
+        evas_object_size_hint_weight_set(o, EVAS_HINT_EXPAND, 0);
+        evas_object_size_hint_align_set(o, EVAS_HINT_FILL, EVAS_HINT_FILL);
+        evas_object_show(o);
+        elm_table_pack(tb, o, i % 2, i / 2, 1, 1);
+     }
+   evas_object_size_hint_align_set(tb, EVAS_HINT_FILL, 0.5);
+   evas_object_show(tb);
+   elm_box_pack_end(box, tb);
+
+   /* volume e brilho */
+   o = _track(&s->o_sliders, _edje(e_comp->evas, THEME_GROUP("sliders")));
+   if (o)
+     {
+        _track(&s->o_vol, _slider_add());
+        elm_slider_value_set(s->o_vol, st.vol >= 0 ? MIN(st.vol, 100) : 0);
+        elm_object_disabled_set(s->o_vol, st.vol < 0);
+        evas_object_smart_callback_add(s->o_vol, "slider,drag,start", _cb_vol_drag, s);
+        evas_object_smart_callback_add(s->o_vol, "delay,changed", _cb_vol, s);
+        edje_object_part_swallow(o, "e.swallow.volume", s->o_vol);
+
+        _track(&s->o_bri, _slider_add());
+        e_backlight_mode_set(zone, E_BACKLIGHT_MODE_NORMAL);
+        elm_slider_value_set(s->o_bri, _backlight_has() ? e_backlight_level_get(zone) * 100.0 : 0);
+        elm_object_disabled_set(s->o_bri, !_backlight_has());
+        evas_object_smart_callback_add(s->o_bri, "delay,changed", _cb_bri, s);
+        edje_object_part_swallow(o, "e.swallow.brightness", s->o_bri);
+        _swallows_owned(o, _parts_sliders);
+
+        _min_hint(o);
+        evas_object_size_hint_align_set(o, EVAS_HINT_FILL, 0.5);
+        evas_object_show(o);
+        elm_box_pack_end(box, o);
+     }
+
+   /* rodapé: bateria, bloquear e desligar */
+   o = _track(&s->o_footer, _edje(e_comp->evas, THEME_GROUP("footer")));
+   if (o)
+     {
+        edje_object_part_swallow(o, "e.swallow.lock", _track(&s->o_lock, _button_add(s, "lock")));
+        edje_object_part_swallow(o, "e.swallow.power", _track(&s->o_power, _button_add(s, "power")));
+        _swallows_owned(o, _parts_footer);
+        _min_hint(o);
+        evas_object_size_hint_align_set(o, EVAS_HINT_FILL, 0.5);
+        evas_object_show(o);
+        elm_box_pack_end(box, o);
+     }
+
+   _popup_update(s);
+   evas_object_show(box);
+   e_gadcon_popup_content_set(s->popup, box);
+   e_gadcon_popup_show(s->popup);
+   e_comp_object_util_autoclose(s->popup->comp_object, _cb_popup_comp_del, NULL, s);
+   e_object_data_set(E_OBJECT(s->popup), s);
+   E_OBJECT_DEL_SET(s->popup, _cb_popup_del);
+   evas_object_event_callback_add(s->popup->comp_object, EVAS_CALLBACK_DEL,
+                                  _cb_popup_frame_del, s);
+   edje_object_signal_emit(s->o, "e,state,active", "e");
+
+   _query_all(EINA_TRUE);
+}
+
+static void
+_cb_status_mouse_down(void *data, Evas *evas EINA_UNUSED, Evas_Object *obj EINA_UNUSED, void *event)
+{
+   Status *s = data;
+   Evas_Event_Mouse_Down *ev = event;
+
+   if (ev->button == 1)
+     {
+        if (s->popup) _popup_del(s);
+        else _popup_new(s);
+     }
+   else if (ev->button == 3)
+     {
+        E_Menu *m;
+        int x, y;
+
+        m = e_menu_new();
+        m = e_gadcon_client_util_menu_items_append(s->gcc, m, 0);
+        e_gadcon_canvas_zone_geometry_get(s->gcc->gadcon, &x, &y, NULL, NULL);
+        e_menu_activate_mouse(m, e_zone_current_get(), x + ev->output.x, y + ev->output.y,
+                              1, 1, E_MENU_POP_DIRECTION_AUTO, ev->timestamp);
+        evas_event_feed_mouse_up(s->gcc->gadcon->evas, ev->button,
+                                 EVAS_BUTTON_NONE, ev->timestamp, NULL);
+     }
+}
+
+static void
+_cb_status_wheel(void *data EINA_UNUSED, Evas *evas EINA_UNUSED, Evas_Object *obj EINA_UNUSED, void *event)
+{
+   Evas_Event_Mouse_Wheel *ev = event;
+
+   if (st.vol < 0) return;
+   _run(ev->z < 0 ? "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ 2>/dev/null || "
+                    "pactl set-sink-volume @DEFAULT_SINK@ +5%"
+                  : "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- 2>/dev/null || "
+                    "pactl set-sink-volume @DEFAULT_SINK@ -5%");
+   st.vol = MAX(0, MIN(100, st.vol + (ev->z < 0 ? 5 : -5)));
+   _update_all();
+}
