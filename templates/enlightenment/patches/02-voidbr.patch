+static Evas_Object *
+_button_add(Status *s, const char *name)
+{
+   char grp[128];
+   Evas_Object *o;
+
+   snprintf(grp, sizeof(grp), THEME_GROUP("button/%s"), name);
+   o = _edje(e_comp->evas, grp);
+   if (!o) return NULL;
+   evas_object_data_set(o, "voidbr_button", name);
+   edje_object_signal_callback_add(o, "e,action,click", "e", _cb_button, s);
+   _min_hint(o);
+   evas_object_show(o);
+   return o;
+}
