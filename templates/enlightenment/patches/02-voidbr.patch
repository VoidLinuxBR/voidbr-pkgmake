@@ -0,0 +1,1144 @@
+/*
+ * Módulo "voidbr" do Enlightenment (VoidBR Linux)
+ *
+ * Dois gadgets para a barra:
+ *
+ *   voidbr-status  pílula com Wi-Fi, volume e bateria. Um clique abre a
+ *                  central de controle: cartões de Wi-Fi, Bluetooth, Mosaico,
+ *                  Não perturbe, Captura e Ajustes; volume e brilho; bloquear
+ *                  e desligar.
+ *   voidbr-title   título da janela ativa.
+ *
+ * O visual vem dos grupos e/modules/voidbr/... do tema VoidBR
+ * (voidbr-enlightenment-config, src/theme/central.edc).
+ *
+ * Wi-Fi e Bluetooth usam nmcli e bluetoothctl; o volume usa wpctl
+ * (PipeWire) ou, na falta dele, pactl. Se um deles não existir, o item correspondente some ou
+ * fica sem efeito. O brilho usa o backlight do próprio E.
+ */
+#include "e.h"
+#include <pwd.h>
+#include <dirent.h>
+#include <ctype.h>
+
+#define THEME_GROUP(_g) "e/modules/voidbr/" _g
+
+/* revisão do módulo (grep -a voidbr-mod-rev no module.so instalado) */
+__attribute__((used)) static const char _voidbr_rev[] = "voidbr-mod-rev-7";
+
+/* -------------------------------------------------------------- estado */
+
+typedef enum
+{
+   CARD_WIFI,
+   CARD_BT,
+   CARD_TILING,
+   CARD_DND,
+   CARD_SHOT,
+   CARD_TWEAKS,
+   CARD_LAST
+} Card_Id;
+
+typedef struct
+{
+   E_Gadcon_Client *gcc;
+   Evas_Object     *o;
+   E_Gadcon_Popup  *popup;
+   Evas_Object     *o_header, *o_sliders, *o_footer;
+   Evas_Object     *o_card[CARD_LAST];
+   Evas_Object     *o_vol, *o_bri;
+   Evas_Object     *o_settings, *o_lock, *o_power;
+   Evas_Object     *o_box, *o_table;
+} Status;
+
+typedef struct
+{
+   E_Gadcon_Client *gcc;
+   Evas_Object     *o;
+} Title;
+
+static struct
+{
+   E_Module    *module;
+   Eina_List   *status, *titles, *handlers;
+   Ecore_Timer *poll, *refresh;
+   int          poll_count;
+   int          wifi;       /* -1 sem placa, 0 desconectado, 1 conectado */
+   int          wifi_radio; /* -1 sem nmcli, 0 desligado, 1 ligado */
+   char         ssid[128];
+   int          bt;         /* -1 sem controlador, 0 desligado, 1 ligado */
+   int          vol;        /* -1 sem wpctl, 0..150 */
+   Eina_Bool    mute;
+   int          bat;        /* -1 sem bateria, 0..100 */
+   Eina_Bool    charging;
+   Eina_Bool    vol_busy;   /* usuário mexendo no slider */
+} st;
+
+static const char *EXE_TAG = "voidbr-mod";
+
+static void _status_update(Status *s);
+static void _popup_update(Status *s);
+static void _popup_del(Status *s);
+
+/* ----------------------------------------------------------- utilidades */
+
+static Evas_Object *
+_edje(Evas *evas, const char *group)
+{
+   Evas_Object *o = edje_object_add(evas);
+   if (!e_theme_edje_object_set(o, "base/theme/modules/voidbr", group))
+     {
+        evas_object_del(o);
+        return NULL;
+     }
+   return o;
+}
+
+/* o edje não apaga o que está "engolido" (swallow) quando é apagado: sem isso
+ * os botões e os controles ficavam soltos na tela ao fechar a central */
+static void
+_cb_swallows_del(void *data, Evas *e EINA_UNUSED, Evas_Object *obj, void *event EINA_UNUSED)
+{
+   const char **parts = data;
+   Evas_Object *c;
+   int i;
+
+   for (i = 0; parts[i]; i++)
+     {
+        c = edje_object_part_swallow_get(obj, parts[i]);
+        if (!c) continue;
+        edje_object_part_unswallow(obj, c);
+        evas_object_del(c);
+     }
+}
+
+static void
+_cb_ptr_null(void *data, Evas *e EINA_UNUSED, Evas_Object *obj EINA_UNUSED, void *event EINA_UNUSED)
+{
+   Evas_Object **ptr = data;
+   *ptr = NULL;
+}
+
+/* guarda o objeto em *ptr e zera *ptr quando ele for apagado por outro caminho */
+static Evas_Object *
+_track(Evas_Object **ptr, Evas_Object *o)
+{
+   *ptr = o;
+   if (o) evas_object_event_callback_add(o, EVAS_CALLBACK_DEL, _cb_ptr_null, ptr);
+   return o;
+}
+
+static void
+_untrack_del(Evas_Object **ptr)
+{
+   Evas_Object *o = *ptr;
+
+   if (!o) return;
+   evas_object_event_callback_del_full(o, EVAS_CALLBACK_DEL, _cb_ptr_null, ptr);
+   *ptr = NULL;
+   evas_object_del(o);
+}
+
+static const char *_parts_header[] = { "e.swallow.button", NULL };
+static const char *_parts_sliders[] = { "e.swallow.volume", "e.swallow.brightness", NULL };
+static const char *_parts_footer[] = { "e.swallow.lock", "e.swallow.power", NULL };
+
+static void
+_swallows_owned(Evas_Object *o, const char **parts)
+{
+   evas_object_event_callback_add(o, EVAS_CALLBACK_DEL, _cb_swallows_del, parts);
+}
+
+static void
+_min_hint(Evas_Object *o)
+{
+   Evas_Coord mw = 0, mh = 0, w = 0, h = 0;
+   edje_object_size_min_get(o, &mw, &mh);
+   edje_object_size_min_restricted_calc(o, &w, &h, mw, mh);
+   evas_object_size_hint_min_set(o, MAX(w, mw), MAX(h, mh));
+}
+
+static Eina_Bool
+_file_read(const char *path, char *buf, size_t len)
+{
+   FILE *f = fopen(path, "r");
+   size_t n;
+
+   if (!f) return EINA_FALSE;
+   n = fread(buf, 1, len - 1, f);
+   fclose(f);
+   buf[n] = 0;
+   while (n && ((buf[n - 1] == '\n') || (buf[n - 1] == ' '))) buf[--n] = 0;
+   return EINA_TRUE;
+}
+
+/* tela com brilho ajustável? (VMs e desktops costumam não ter) */
+static Eina_Bool
+_backlight_has(void)
+{
+   Eina_List *l = ecore_file_ls("/sys/class/backlight");
+   Eina_Bool has = !!l;
+
+   E_FREE_LIST(l, free);
+   return has && e_backlight_exists();
+}
+
+static void
+_run(const char *cmd)
+{
+   ecore_exe_run(cmd, NULL);
+}
+
+/* comandos cuja saída interessa: a tag diz como ler */
+static void
+_query(const char *tag, const char *cmd)
+{
+   Ecore_Exe *exe;
+
+   exe = ecore_exe_pipe_run(cmd, ECORE_EXE_PIPE_READ | ECORE_EXE_PIPE_READ_LINE_BUFFERED |
+                            ECORE_EXE_NOT_LEADER | ECORE_EXE_TERM_WITH_PARENT, (void *)EXE_TAG);
+   if (exe) ecore_exe_tag_set(exe, tag);
+}
+
+/* ----------------------------------------------------------- leituras */
+
+static void
+_read_sys(void)
+{
+   DIR *d;
+   struct dirent *de;
+   char path[PATH_MAX], buf[64];
+
+   /* Wi-Fi: alguma interface sem fio? está "up"? */
+   st.wifi = -1;
+   if ((d = opendir("/sys/class/net")))
+     {
+        while ((de = readdir(d)))
+          {
+             if (de->d_name[0] == '.') continue;
+             snprintf(path, sizeof(path), "/sys/class/net/%s/wireless", de->d_name);
+             if (!ecore_file_is_dir(path)) continue;
+             if (st.wifi < 0) st.wifi = 0;
+             snprintf(path, sizeof(path), "/sys/class/net/%s/operstate", de->d_name);
+             if (_file_read(path, buf, sizeof(buf)) && !strcmp(buf, "up")) st.wifi = 1;
+          }
+        closedir(d);
+     }
+
+   /* bateria */
+   st.bat = -1;
+   st.charging = EINA_FALSE;
+   if ((d = opendir("/sys/class/power_supply")))
+     {
+        while ((de = readdir(d)))
+          {
+             if (de->d_name[0] == '.') continue;
+             snprintf(path, sizeof(path), "/sys/class/power_supply/%s/type", de->d_name);
+             if (!_file_read(path, buf, sizeof(buf)) || strcmp(buf, "Battery")) continue;
+             snprintf(path, sizeof(path), "/sys/class/power_supply/%s/capacity", de->d_name);
+             if (!_file_read(path, buf, sizeof(buf))) continue;
+             st.bat = atoi(buf);
+             snprintf(path, sizeof(path), "/sys/class/power_supply/%s/status", de->d_name);
+             if (_file_read(path, buf, sizeof(buf)))
+               st.charging = (!strcmp(buf, "Charging") || !strcmp(buf, "Full"));
+             break;
+          }
+        closedir(d);
+     }
+}
+
+static void
+_query_all(Eina_Bool slow)
+{
+   if (!st.vol_busy)
+     _query("vol", "wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || "
+                   "{ pactl get-sink-volume @DEFAULT_SINK@; pactl get-sink-mute @DEFAULT_SINK@; } 2>/dev/null");
+   if (slow)
+     {
+        _query("radio", "nmcli radio wifi 2>/dev/null");
+        _query("ssid", "nmcli -t -f active,ssid dev wifi 2>/dev/null");
+        _query("bt", "bluetoothctl show 2>/dev/null");
+     }
+}
+
+static void
+_update_all(void)
+{
+   Eina_List *l;
+   Status *s;
+
+   EINA_LIST_FOREACH(st.status, l, s)
+     {
+        _status_update(s);
+        if (s->popup) _popup_update(s);
+     }
+}
+
+static Eina_Bool
+_cb_exe_data(void *data EINA_UNUSED, int type EINA_UNUSED, void *event)
+{
+   Ecore_Exe_Event_Data *ev = event;
+   const char *tag;
+   int i;
+
+   if (ecore_exe_data_get(ev->exe) != EXE_TAG) return ECORE_CALLBACK_PASS_ON;
+   tag = ecore_exe_tag_get(ev->exe);
+   if (!tag || !ev->lines) return ECORE_CALLBACK_DONE;
+
+   if (!strcmp(tag, "vol"))
+     {
+        /* wpctl: "Volume: 0.70 [MUTED]"
+         * pactl: "Volume: front-left: 45875 /  70% / ..." e "Mute: yes" */
+        for (i = 0; ev->lines[i].line; i++)
+          {
+             const char *l = ev->lines[i].line, *p, *pc;
+
+             if (!strncmp(l, "Mute:", 5))
+               {
+                  st.mute = !!strstr(l, "yes");
+                  continue;
+               }
+             if (!(p = strstr(l, "Volume:"))) continue;
+             if ((pc = strchr(p, '%')))
+               {
+                  while ((pc > p) && isdigit((unsigned char)pc[-1])) pc--;
+                  st.vol = atoi(pc);
+               }
+             else
+               {
+                  st.vol = (int)(atof(p + 7) * 100.0 + 0.5);
+                  st.mute = !!strstr(p, "MUTED");
+               }
+          }
+     }
+   else if (!strcmp(tag, "radio"))
+     {
+        if (ev->lines[0].line)
+          st.wifi_radio = !strncmp(ev->lines[0].line, "enabled", 7);
+     }
+   else if (!strcmp(tag, "ssid"))
+     {
+        st.ssid[0] = 0;
+        for (i = 0; ev->lines[i].line; i++)
+          {
+             if (!strncmp(ev->lines[i].line, "yes:", 4))
+               {
+                  eina_strlcpy(st.ssid, ev->lines[i].line + 4, sizeof(st.ssid));
+                  break;
+               }
+          }
+     }
+   else if (!strcmp(tag, "bt"))
+     {
+        for (i = 0; ev->lines[i].line; i++)
+          {
+             const char *p = strstr(ev->lines[i].line, "Powered:");
+             if (p) st.bt = !!strstr(p, "yes");
+          }
+     }
+   _update_all();
+   return ECORE_CALLBACK_DONE;
+}
+
+static Eina_Bool
+_cb_poll(void *data EINA_UNUSED)
+{
+   _read_sys();
+   _query_all((st.poll_count++ % 4) == 0); /* nmcli e bluetoothctl a cada 12 s */
+   _update_all();
+   return ECORE_CALLBACK_RENEW;
+}
+
+static Eina_Bool
+_cb_refresh(void *data EINA_UNUSED)
+{
+   st.refresh = NULL;
+   _read_sys();
+   _query_all(EINA_TRUE);
+   _update_all();
+   return ECORE_CALLBACK_CANCEL;
+}
+
+/* atualiza logo depois de uma ação (nmcli/bluetoothctl demoram um pouco) */
+static void
+_refresh_soon(void)
+{
+   if (st.refresh) ecore_timer_del(st.refresh);
+   st.refresh = ecore_timer_loop_add(1.0, _cb_refresh, NULL);
+}
+
+/* ------------------------------------------------------- pílula da barra */
+
+static void
+_status_update(Status *s)
+{
+   Edje_Message_Float msg;
+   char buf[32];
+
+   if (!s->o) return;
+   if (st.wifi < 0) edje_object_signal_emit(s->o, "e,wifi,none", "e");
+   else edje_object_signal_emit(s->o, st.wifi ? "e,wifi,on" : "e,wifi,off", "e");
+
+   if (st.mute || (st.vol == 0)) edje_object_signal_emit(s->o, "e,vol,mute", "e");
+   else if ((st.vol > 0) && (st.vol < 40)) edje_object_signal_emit(s->o, "e,vol,low", "e");
+   else edje_object_signal_emit(s->o, "e,vol,high", "e");
+
+   if (st.bat < 0)
+     {
+        edje_object_signal_emit(s->o, "e,bat,none", "e");
+        edje_object_part_text_set(s->o, "e.text.battery", "");
+     }
+   else
+     {
+        edje_object_signal_emit(s->o, ((st.bat <= 15) && !st.charging) ? "e,bat,low" : "e,bat,ok", "e");
+        edje_object_signal_emit(s->o, st.charging ? "e,charging,on" : "e,charging,off", "e");
+        snprintf(buf, sizeof(buf), "%i%%", st.bat);
+        edje_object_part_text_set(s->o, "e.text.battery", buf);
+        msg.val = st.bat / 100.0;
+        edje_object_message_send(s->o, EDJE_MESSAGE_FLOAT, 1, &msg);
+     }
+   edje_object_message_signal_process(s->o);
+   if (s->gcc)
+     {
+        /* largura pelo que aparece (mesmas medidas do grupo status do tema):
+         * margem 10, ícones de 16 (bateria 20) separados por 10, texto, margem 12 */
+        Evas_Coord mw = 0, mh = 0, w;
+        const Evas_Object *tx;
+
+        edje_object_size_min_get(s->o, &mw, &mh);
+        w = (st.wifi >= 0) ? (10 + 16 + 10) : (4 + 10);
+        w += 16;
+        if (st.bat >= 0)
+          {
+             w += 10 + 20 + 5;
+             tx = edje_object_part_object_get(s->o, "e.text.battery");
+             if (tx) w += evas_object_text_horiz_advance_get(tx) / e_scale;
+          }
+        w += 12;
+        w = w * e_scale;
+        if (mh < 1) mh = 28 * e_scale;
+        e_gadcon_client_min_size_set(s->gcc, w, mh);
+        e_gadcon_client_aspect_set(s->gcc, w, mh);
+     }
+}
+
+/* --------------------------------------------------- central de controle */
+
+static Eina_Bool
+_module_on(const char *name)
+{
+   E_Module *m = e_module_find(name);
+   return m && e_module_enabled_get(m);
+}
+
+static void
+_module_toggle(const char *name)
+{
+   E_Module *m = e_module_find(name);
+
+   if (!m) m = e_module_new(name);
+   if (!m) return;
+   if (e_module_enabled_get(m)) e_module_disable(m);
+   else e_module_enable(m);
+   e_config_save_queue();
+}
+
+static void
+_card_set(Evas_Object *o, Eina_Bool on, const char *label, const char *sub)
+{
+   if (!o) return;
+   edje_object_signal_emit(o, on ? "e,state,on" : "e,state,off", "e");
+   edje_object_part_text_set(o, "e.text.label", label);
+   edje_object_part_text_set(o, "e.text.sub", sub);
+}
+
+static void
+_uptime_text(char *buf, size_t len)
+{
+   char s[64];
+   long t;
+
+   if (!_file_read("/proc/uptime", s, sizeof(s))) { buf[0] = 0; return; }
+   t = atol(s);
+   if (t >= 86400)
+     snprintf(buf, len, "ligado há %li d %li h", t / 86400, (t % 86400) / 3600);
+   else if (t >= 3600)
+     snprintf(buf, len, "ligado há %li h %li min", t / 3600, (t % 3600) / 60);
+   else
+     snprintf(buf, len, "ligado há %li min", t / 60);
+}
+
+static void
+_popup_update(Status *s)
+{
+   char buf[256];
+
+   /* Wi-Fi */
+   if (st.wifi < 0)
+     _card_set(s->o_card[CARD_WIFI], EINA_FALSE, "Wi-Fi", "Sem placa");
+   else if (st.wifi_radio == 0)
+     _card_set(s->o_card[CARD_WIFI], EINA_FALSE, "Wi-Fi", "Desligado");
+   else
+     _card_set(s->o_card[CARD_WIFI], EINA_TRUE, "Wi-Fi",
+               st.ssid[0] ? st.ssid : (st.wifi ? "Conectado" : "Ligado"));
+
+   /* Bluetooth */
+   if (st.bt < 0)
+     _card_set(s->o_card[CARD_BT], EINA_FALSE, "Bluetooth", "Sem adaptador");
+   else
+     _card_set(s->o_card[CARD_BT], st.bt, "Bluetooth", st.bt ? "Ligado" : "Desligado");
+
+   _card_set(s->o_card[CARD_TILING], _module_on("tiling"), "Mosaico",
+             _module_on("tiling") ? "Ligado" : "Desligado");
+   _card_set(s->o_card[CARD_DND], !_module_on("notification"), "Não perturbe",
+             _module_on("notification") ? "Desligado" : "Ligado");
+   _card_set(s->o_card[CARD_SHOT], EINA_FALSE, "Captura", "Tela ou área");
+   _card_set(s->o_card[CARD_TWEAKS], EINA_FALSE, "Ajustes", "VoidBR");
+
+   /* volume e brilho */
+   if (s->o_sliders)
+     {
+        if (st.vol >= 0)
+          {
+             if (!st.vol_busy) elm_slider_value_set(s->o_vol, MIN(st.vol, 100));
+             snprintf(buf, sizeof(buf), st.mute ? "mudo" : "%i%%", MIN(st.vol, 100));
+             edje_object_part_text_set(s->o_sliders, "e.text.volume", buf);
+          }
+        else
+          edje_object_part_text_set(s->o_sliders, "e.text.volume", "—");
+        if (_backlight_has())
+          {
+             snprintf(buf, sizeof(buf), "%i%%",
+                      (int)(elm_slider_value_get(s->o_bri) + 0.5));
+             edje_object_part_text_set(s->o_sliders, "e.text.brightness", buf);
+          }
+        else
+          edje_object_part_text_set(s->o_sliders, "e.text.brightness", "—");
+     }
+
+   /* rodapé */
+   if (s->o_footer)
+     {
+        if (st.bat < 0) buf[0] = 0;
+        else snprintf(buf, sizeof(buf), st.charging ? "Bateria %i%% · carregando" : "Bateria %i%%", st.bat);
+        edje_object_part_text_set(s->o_footer, "e.text.battery", buf);
+     }
+   if (s->o_header)
+     {
+        _uptime_text(buf, sizeof(buf));
+        edje_object_part_text_set(s->o_header, "e.text.sub", buf);
+     }
+}
