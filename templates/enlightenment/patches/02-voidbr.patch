+static void
+_action(const char *name, const char *params)
+{
+   E_Action *a = e_action_find(name);
+   if (a && a->func.go) a->func.go(NULL, params);
+}
+
+static void
+_cb_card(void *data, Evas_Object *obj, const char *emission EINA_UNUSED, const char *source EINA_UNUSED)
+{
+   Status *s = data;
+   Card_Id id = (Card_Id)(intptr_t)evas_object_data_get(obj, "voidbr_card");
+
+   switch (id)
+     {
+      case CARD_WIFI:
+        if (st.wifi < 0) return;
+        _run(st.wifi_radio == 0 ? "nmcli radio wifi on" : "nmcli radio wifi off");
+        st.wifi_radio = !st.wifi_radio;
+        break;
+      case CARD_BT:
+        if (st.bt < 0) return;
+        _run(st.bt ? "bluetoothctl power off" : "bluetoothctl power on");
+        st.bt = !st.bt;
+        break;
+      case CARD_TILING:
+        _module_toggle("tiling");
+        break;
+      case CARD_DND:
+        _module_toggle("notification");
+        break;
+      case CARD_SHOT:
+        _popup_del(s);
+        if (!_module_on("shot")) _module_toggle("shot");
+        _action("shot", NULL);
+        return;
+      case CARD_TWEAKS:
+        _popup_del(s);
+        e_exec(e_zone_current_get(), NULL, "voidbr-enlightenment-tweaks", NULL, NULL);
+        return;
+      default:
+        return;
+     }
+   _popup_update(s);
+   _refresh_soon();
+}
+
+static void
+_cb_button(void *data, Evas_Object *obj, const char *emission EINA_UNUSED, const char *source EINA_UNUSED)
+{
+   Status *s = data;
+   const char *what = evas_object_data_get(obj, "voidbr_button");
+
+   _popup_del(s);
+   if (!what) return;
+   if (!strcmp(what, "settings")) _action("configuration", NULL);
+   else if (!strcmp(what, "lock")) e_desklock_show(EINA_FALSE);
+   else if (!strcmp(what, "power")) _action("syscon", NULL);
+}
+
+static void
+_cb_vol_drag(void *data EINA_UNUSED, Evas_Object *obj EINA_UNUSED, void *event EINA_UNUSED)
+{
+   st.vol_busy = EINA_TRUE;
+}
+
+static void
+_cb_vol(void *data, Evas_Object *obj, void *event EINA_UNUSED)
+{
+   Status *s = data;
+   char cmd[128];
+   int v = (int)(elm_slider_value_get(obj) + 0.5);
+
+   snprintf(cmd, sizeof(cmd), "wpctl set-volume @DEFAULT_AUDIO_SINK@ %i%% 2>/dev/null || "
+            "pactl set-sink-volume @DEFAULT_SINK@ %i%%", v, v);
+   _run(cmd);
+   if (st.mute)
+     _run("wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 2>/dev/null || pactl set-sink-mute @DEFAULT_SINK@ 0");
+   st.vol = v;
+   st.mute = EINA_FALSE;
+   st.vol_busy = EINA_FALSE;
+   _update_all();
+   (void)s;
+}
+
+static void
+_cb_bri(void *data, Evas_Object *obj, void *event EINA_UNUSED)
+{
+   Status *s = data;
+   double v = elm_slider_value_get(obj) / 100.0;
+   E_Zone *zone = s->gcc ? s->gcc->gadcon->zone : e_zone_current_get();
+
+   if (v < 0.05) v = 0.05;
+   e_backlight_mode_set(zone, E_BACKLIGHT_MODE_NORMAL);
+   e_backlight_level_set(zone, v, 0.0);
+   e_config->backlight.normal = v;
+   e_config_save_queue();
+   _popup_update(s);
+}
