+static Eina_Bool
+_cb_client(void *data EINA_UNUSED, int type, void *event)
+{
+   if (type == E_EVENT_CLIENT_PROPERTY)
+     {
+        E_Event_Client_Property *ev = event;
+        if (!(ev->property & E_CLIENT_PROPERTY_TITLE)) return ECORE_CALLBACK_PASS_ON;
+        if (ev->ec != e_client_focused_get()) return ECORE_CALLBACK_PASS_ON;
