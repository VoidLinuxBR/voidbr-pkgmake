+static E_Gadcon_Client *
+_st_init(E_Gadcon *gc, const char *name, const char *id, const char *style)
+{
+   Status *s;
+   Evas_Object *o;
+
+   o = _edje(gc->evas, THEME_GROUP("status"));
+   if (!o) return NULL;
+   s = E_NEW(Status, 1);
+   s->o = o;
+   evas_object_show(o);
+   s->gcc = e_gadcon_client_new(gc, name, id, style, o);
+   s->gcc->data = s;
+   evas_object_event_callback_add(o, EVAS_CALLBACK_MOUSE_DOWN, _cb_status_mouse_down, s);
+   evas_object_event_callback_add(o, EVAS_CALLBACK_MOUSE_WHEEL, _cb_status_wheel, s);
+   st.status = eina_list_append(st.status, s);
+   _status_update(s);
+   return s->gcc;
+}
