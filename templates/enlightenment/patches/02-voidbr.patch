+/* apaga tudo o que a central criou, de dentro para fora; seguro chamar 2 vezes */
+static void
+_popup_cleanup(Status *s)
+{
+   int i;
+
+   _untrack_del(&s->o_settings);
+   _untrack_del(&s->o_lock);
+   _untrack_del(&s->o_power);
+   _untrack_del(&s->o_vol);
+   _untrack_del(&s->o_bri);
+   for (i = 0; i < CARD_LAST; i++) _untrack_del(&s->o_card[i]);
+   _untrack_del(&s->o_header);
+   _untrack_del(&s->o_sliders);
+   _untrack_del(&s->o_footer);
+   _untrack_del(&s->o_table);
+   _untrack_del(&s->o_box);
+   st.vol_busy = EINA_FALSE;
+}
+
+/* o quadro do popup foi apagado (qualquer caminho): limpa também */
+static void
+_cb_popup_frame_del(void *data, Evas *e EINA_UNUSED, Evas_Object *obj EINA_UNUSED, void *event EINA_UNUSED)
+{
+   Status *s = data;
+
+   _popup_cleanup(s);
+   s->popup = NULL;
+   if (s->o) edje_object_signal_emit(s->o, "e,state,passive", "e");
+}
+
+static void
+_cb_popup_comp_del(void *data, Evas_Object *obj EINA_UNUSED)
+{
+   _popup_del(data);
+}
+
+static void
+_cb_popup_del(void *obj)
+{
+   Status *s = e_object_data_get(obj);
+
+   if (!s) return;
+   if (s->popup && s->popup->comp_object)
+     evas_object_event_callback_del_full(s->popup->comp_object, EVAS_CALLBACK_DEL,
+                                         _cb_popup_frame_del, s);
+   s->popup = NULL;
+   _popup_cleanup(s);
+   if (s->o) edje_object_signal_emit(s->o, "e,state,passive", "e");
+}
