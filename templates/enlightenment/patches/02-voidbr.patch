+_st_shutdown(E_Gadcon_Client *gcc)
+{
+   Status *s = gcc->data;
+
+   _popup_del(s);
+   st.status = eina_list_remove(st.status, s);
+   evas_object_del(s->o);
+   free(s);
+}
