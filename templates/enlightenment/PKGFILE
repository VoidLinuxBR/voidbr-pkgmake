# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>
#
# Enlightenment 0.28 para o VoidBR (o Void está no 0.25.4). Baseado no template
# do Void (srcpkgs/enlightenment). Precisa do efl >= 1.29 (pacote efl do VoidBR).
#
# Novidades em relação ao 0.25: módulo do NetworkManager, mixer PipeWire,
# histórico da área de transferência, e os eventos de ACPI (tampa, botões)
# lidos direto do /dev/input, sem acpid.
#
# Patches do VoidBR: 01 suspende com zzz/ZZZ; 02 adiciona o módulo "voidbr"
# (central de controle) e o nome/botões de energia na tela de bloqueio.
#
# Como no efl, os headers/.pc (enlightenment-devel no Void) vão neste pacote.

pkgname=enlightenment
pkgver=0.28.0
pkgrel=11
pkgdesc='Enlightenment desktop shell'
arch=(x86_64 aarch64)
url=https://www.enlightenment.org
license=(BSD-2-Clause)
provides=("enlightenment-devel-${pkgver}_${pkgrel}") # headers e .pc do enlightenment-devel vêm aqui
replaces=(enlightenment-devel)                       # remove o enlightenment-devel do Void
conflicts=()
depends=(
	'efl>=1.29.0'
	desktop-file-utils
	hicolor-icon-theme
	xkeyboard-config
	xorg-server-xwayland # sessão Wayland
)
makedepends=(
	meson
	pkgconf
	gettext
	'efl>=1.29.0' # headers e .pc do efl (o efl do VoidBR já inclui o efl-devel)
	pam-devel
	xkeyboard-config
	libexif-devel
	libxkbcommon-devel
	MesaLib-devel
	wayland-devel
	wayland-protocols
	xorg-server-xwayland
	# Os .pc do efl citam as bibliotecas usadas no build do efl (Requires.private),
	# e o pkg-config precisa delas para compilar contra o efl: no Void isso vem como
	# dependência do efl-devel; aqui vai a mesma lista do makedepends do efl.
	gettext-devel
	openssl-devel
	liblz4-devel
	glib-devel
	ibus-devel
	fontconfig-devel
	fribidi-devel
	harfbuzz-devel
	libjpeg-turbo-devel
	libpng-devel
	giflib-devel
	tiff-devel
	libwebp-devel
	avahi-libs-devel
	eudev-libudev-devel
	libgomp-devel
	libsndfile-devel
	libmount-devel
	LuaJIT-devel
	lua52-devel
	poppler-cpp-devel
	librsvg-devel
	libspectre-devel
	libraw-devel
	libopenjpeg2-devel
	libheif-devel
	libavif-devel
	libjxl-devel
	openh264-devel
	libdrm-devel
	libinput-devel
	elogind-devel
	gst-plugins-base1-devel
	libXcomposite-devel
	libXcursor-devel
	libXp-devel
	libXrandr-devel
	libXScrnSaver-devel
	libXdamage-devel
	libXrender-devel
	libXi-devel
	libXinerama-devel
	libXpresent-devel
	xcb-util-devel
	xcb-util-keysyms-devel
	xcb-util-image-devel
	xcb-util-renderutil-devel
	xcb-util-wm-devel
	xorgproto
	pulseaudio-devel
	pipewire-devel
)
backup=(etc/enlightenment/sysactions.conf)
source=("https://download.enlightenment.org/rel/apps/${pkgname}/${pkgname}-${pkgver}.tar.xz")
checksum="8ab2d8a76c4009d142561f5136048b969796f4a79df8af6018713d1d163a5c6b"

prepare() {
	# sempre de um fonte limpo: o pkgmake extrai por cima do anterior, e os
	# arquivos criados pelos patches (módulo voidbr) ficavam da versão velha
	cd "${srcdir}"
	rm -rf "${pkgname}-${pkgver}"
	tar -xJf "${pkgname}-${pkgver}.tar.xz"
	cd "${pkgname}-${pkgver}"

	# suspender/hibernar com zzz/ZZZ (o E 0.28 só conhece systemctl, sleep.sh e pm-suspend)
	patch -Np1 -i ../../patches/01-void-zzz.patch

	# módulo voidbr (pílula de status, central de controle, título da janela) e
	# tela de bloqueio com nome do usuário e botões de energia; o visual vem do
	# tema do voidbr-enlightenment-config
	patch -Np1 -i ../../patches/02-voidbr.patch
}

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	meson setup build \
		--prefix=/usr \
		--libdir=lib \
		--sysconfdir=/etc \
		--buildtype=release \
		-Dpam=true \
		-Dsystemd=false \
		-Dwl=true \
		-Dpants=false

	meson compile -C build
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	DESTDIR="${pkgdir}" meson install -C build

	install -Dm 644 COPYING -t "${pkgdir}"/usr/share/licenses/${pkgname}/
	rm -rf "${pkgdir}"/usr/share/${pkgname}/doc

	# wallpapers do E: o 0.28 instala 23 .edj (388 MB). A edição VoidBR usa o
	# wallpaper do voidbr-wallpapers, então ficam só os leves (~7 MB no total).
	local bg k keep=(
		Squiggle.edj Squiggle-Dark.edj Squiggle-Mid.edj Squiggle-Light.edj
		Flat-Stone-Pattern.edj Paper-Flower.edj Dunes.edj
	)
	for bg in "${pkgdir}"/usr/share/${pkgname}/data/backgrounds/*.edj; do
		for k in "${keep[@]}"; do
			[[ "${bg##*/}" == "$k" ]] && continue 2
		done
		rm -f "$bg"
	done
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
