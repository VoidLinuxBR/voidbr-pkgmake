pkgname=anydesk-bin
pkgver=8.1.0
pkgrel=1
pkgdesc="The Fast Remote Desktop Application"
arch=('x86_64')
conflicts=('anydesk')
provides=('anydesk')
url="https://anydesk.com"
license=('custom')
depends=(
	fakeroot
	minizip
	libglvnd
	gtk+3
	libX11
	glibc
	glib
	gdk-pixbuf
	libxcb
	cairo
	pango
	libXi
	libXrender
	libXrandr
	libXtst
	libXext
	libXfixes
	libXdamage
	libxkbfile
	libgcc
	polkit
)
options=('!strip')
source=("https://download.anydesk.com/linux/anydesk-${pkgver}-amd64.tar.gz")
sha256sums=('7e0dec2dcbac86ee730efb016a41cb3ff151aa1bdab880b1f3aae5a4ae18916f')

package() {
	# install binary
	install -Dm 755 "${srcdir}/anydesk-${pkgver}/anydesk" "${pkgdir}/usr/bin/anydesk"

	# install desktop entry
	install -Dm 644 "${srcdir}/anydesk-${pkgver}/anydesk.desktop" "${pkgdir}/usr/share/applications/anydesk.desktop"

	# install polkit action
	install -Dm 644 "${srcdir}/anydesk-${pkgver}/polkit-1/com.anydesk.anydesk.policy" "${pkgdir}/usr/share/polkit-1/actions/com.anydesk.anydesk.policy"
	# install icon
	install -Dm 644 "${srcdir}/anydesk-${pkgver}/icons/hicolor/scalable/apps/anydesk.svg" "${pkgdir}/usr/share/pixmaps/anydesk.svg"
	# install license
	install -Dm 644 "${srcdir}/anydesk-${pkgver}/copyright" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

	# install systemd service
	install -Dm 644 "${srcdir}/anydesk-${pkgver}/systemd/anydesk.service" "${pkgdir}/usr/lib/systemd/system/anydesk.service"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
  if [ "${update:-}" = "yes" ]; then
    log "Finalizando upgrade"
  else
    log "Finalizando instalação"
  fi

  mkdir -p /etc/sv/anydesk/log
  tee /etc/sv/anydesk/run >/dev/null <<'EOF'
#!/bin/sh
exec /usr/bin/anydesk --service
EOF

  tee /etc/sv/anydesk/log/run >/dev/null <<'EOF'
#!/bin/sh
exec vlogger -t anydesk
EOF

  chmod +x /etc/sv/anydesk/run /etc/sv/anydesk/log/run
	printf "%b" "\e[1;33m==> WARNING: \e[0mAnyDesk has a runit service for unattended access. Enable it with: vservice enable anydesk\n"

}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
  post_install
}
