pkgname=evisum
pkgver=0.6.0
pkgrel=1
pkgdesc='System and process monitor written with EFL'
arch=(x86_64 aarch64)
url=https://www.enlightenment.org
license=(ISC)
depends=(
	efl
)
makedepends=(
	meson
	pkgconf
	gettext
	efl-devel
)
provides=()
source=("https://download.enlightenment.org/rel/apps/${pkgname}/${pkgname}-${pkgver}.tar.xz")
checksum="256062cfeb6dc1779cbd7c3fe6b958e1a2d0bd6209814dcdbcc032086ecde3c6"

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	meson setup build \
		--prefix=/usr \
		--buildtype=release

	meson compile -C build
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	DESTDIR="${pkgdir}" meson install -C build
	install -Dm 644 COPYING -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
