pkgname=ephoto
pkgver=1.6.0
pkgrel=1
pkgdesc='Image viewer and editor written with EFL'
arch=(x86_64 aarch64)
url=https://www.enlightenment.org
license=(BSD-3-Clause)
depends=(
	efl
	libexif # dados EXIF das fotos (data, câmera, rotação)
)
makedepends=(
	meson
	pkgconf
	gettext
	efl-devel
	libexif-devel
)
provides=()
source=("https://download.enlightenment.org/rel/apps/${pkgname}/${pkgname}-${pkgver}.tar.xz")
checksum="36bc73f3ce1bf9c606630d0031d1629a115911e78b796fd1f90322b5886670d3"

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	meson setup build \
		--prefix=/usr \
		--buildtype=release

	meson compile -C build
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	DESTDIR="${pkgdir}" meson install -C build
	install -Dm 644 COPYING -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
