pkgname=ecrire
pkgver=0.2.0
pkgrel=1
pkgdesc='Simple text editor written with EFL'
arch=(x86_64 aarch64)
url=https://www.enlightenment.org
license=(GPL-3.0-only)
depends=(
	efl
)
makedepends=(
	meson
	pkgconf
	gettext
	efl-devel
)
provides=()
source=("https://download.enlightenment.org/rel/apps/${pkgname}/${pkgname}-${pkgver}.tar.xz")
checksum="d964598790d5b26767e21b7dbc09ca16867f530d50fa363c7694fd3c50995fdf"

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	meson setup build \
		--prefix=/usr \
		--buildtype=release

	meson compile -C build
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	DESTDIR="${pkgdir}" meson install -C build
	install -Dm 644 COPYING -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
