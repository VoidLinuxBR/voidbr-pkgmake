# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>
#
# EFL 1.29 para o VoidBR (o Void está no 1.28.1). Baseado no template do Void
# (srcpkgs/efl), com as mesmas opções de build.
#
# O pkgmake não gera subpacotes: os arquivos de desenvolvimento (headers, .pc,
# cmake), que no Void ficam no efl-devel, vão neste mesmo pacote. Por isso ele
# substitui e fornece o efl-devel.

pkgname=efl
pkgver=1.29.0
pkgrel=1
pkgdesc='Enlightenment Foundation Libraries'
arch=(x86_64 aarch64)
url=https://www.enlightenment.org
license=(LGPL-2.1-only)
provides=("efl-devel-${pkgver}_${pkgrel}") # headers e .pc do efl-devel vêm aqui
replaces=(efl-devel)                       # remove o efl-devel do Void
conflicts=()
depends=()
makedepends=(
	meson
	pkgconf
	gettext
	gettext-devel
	openssl-devel
	liblz4-devel
	glib-devel
	ibus-devel
	fontconfig-devel
	fribidi-devel
	harfbuzz-devel
	libjpeg-turbo-devel
	libpng-devel
	giflib-devel
	tiff-devel
	libwebp-devel
	avahi-libs-devel
	eudev-libudev-devel
	libgomp-devel
	libsndfile-devel
	libmount-devel
	LuaJIT-devel
	lua52-devel
	poppler-cpp-devel
	librsvg-devel
	libspectre-devel
	libraw-devel
	libopenjpeg2-devel
	libheif-devel
	libavif-devel
	libjxl-devel
	openh264-devel
	libdrm-devel
	libinput-devel
	libxkbcommon-devel
	elogind-devel
	gst-plugins-base1-devel
	MesaLib-devel
	wayland-protocols
	wayland-devel
	libXcomposite-devel
	libXcursor-devel
	libXp-devel
	libXrandr-devel
	libXScrnSaver-devel
	libXdamage-devel
	libXrender-devel
	libXi-devel
	libXinerama-devel
	libXpresent-devel
	xcb-util-devel
	xcb-util-keysyms-devel
	xcb-util-image-devel
	xcb-util-renderutil-devel
	xcb-util-wm-devel
	xorgproto
	pulseaudio-devel
	pipewire-devel # novo no EFL 1.29: backend de áudio PipeWire
)
source=("https://download.enlightenment.org/rel/libs/efl/efl-${pkgver}.tar.xz")
checksum="248bc76141f2b8b006ccba9e0bb2cb46cbcb1be4181a1cf2728187f778853654"

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	# mesmas opções do template do Void; avif, heif e jxl ficam habilitados
	# (o padrão do EFL os desliga), o que permite ao E abrir o wallpaper .avif
	meson setup build \
		--prefix=/usr \
		--libdir=lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		-Dbuild-examples=false \
		-Dbuild-tests=false \
		-Dembedded-lz4=false \
		-Dcrypto=openssl \
		-Dnetwork-backend=none \
		-Decore-imf-loaders-disabler=scim \
		-Devas-loaders-disabler=json \
		-Dopengl=es-egl \
		-Dsystemd=true \
		-Dx11=true \
		-Dxpresent=true \
		-Dxinput2=true \
		-Dxinput22=true \
		-Dfb=false \
		-Dwl=true \
		-Ddrm=true \
		-Dgstreamer=true \
		-Dpulseaudio=true \
		-Dpipewire=true \
		-Dharfbuzz=true \
		-Dnative-arch-optimization=false \
		-Dglib=true

	meson compile -C build
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	DESTDIR="${pkgdir}" meson install -C build

	# sem arquivos de serviço do systemd nem o módulo de sistema do systemd (VoidBR usa runit)
	rm -rf "${pkgdir}"/usr/lib/systemd
	rm -rf "${pkgdir}"/usr/lib/ecore/system/systemd

	install -Dm 644 COPYING licenses/* -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
