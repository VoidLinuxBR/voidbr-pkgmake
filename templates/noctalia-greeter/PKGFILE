# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=noctalia-greeter
pkgver=1.6.0
pkgrel=2
pkgdesc="Greetd greeter for Noctalia"
arch=('x86_64')
url="https://github.com/noctalia-dev/noctalia-greeter"
license=('MIT')
options=('!debug')

depends=(
	'cairo'
	'dbus'
	'fontconfig'
	'glib'
	'glibc'
	'greetd'
	'libglvnd'
	'librsvg'
	'libwebp'
	'libxkbcommon'
	'pango'
	'wayland'
	'wlroots0.20'
	freetype
	'libinput'
	'libjxl'
	'libxml2'
	'tomlplusplus'
)
makedepends=(
	'git'
	'meson'
	'ninja'
	'pkgconf'
	'wayland-protocols'
	librsvg-devel
	wlroots0.20-devel
	'stb'
	'libwebp-devel'
	'libjxl-devel'
	'libxml2-devel'
	'libinput-devel'
	'tomlplusplus-devel'
	'nlohmann-json'
	'wayland-devel'
	'libxkbcommon-devel'
	'libglvnd-devel'
	'cairo-devel'
	'pango-devel'
	'fontconfig-devel'
	'freetype-devel'
)
optdepends=(
	'noctalia-git: Wallpaper and palette sync from Noctalia'
)
provides=()
conflicts=()
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
	cd "${pkgname}"

	local version
	version="$(sed -n "s/^  version: '\([^']*\)',/\1/p" meson.build)"
	printf '%s.r%s.g%s' "${version}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=9 HEAD)"
}

build() {
	CXXFLAGS+=" -Wno-unused-result"
	meson setup "${pkgname}" build-release \
		--prefix=/usr \
		-Db_ndebug=true || return 1
	meson compile -C build-release || return 1
}

package() {
	meson install -C build-release --destdir "${pkgdir}"

	install -Dm644 "${pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 "${pkgname}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	if [ ! -x /usr/bin/noctalia-greeter-apply-appearance ]; then
		return 0
	fi

	# prepara /var/lib/noctalia-greeter e o greeter.toml, sem alterar o PAM
	/usr/bin/noctalia-greeter-apply-appearance --setup-system || true

	echo
	log '==> greetd should use: command = "/usr/bin/noctalia-greeter-session"'
	log '==> Full config block: sudo noctalia-greeter-print-greetd-config'
	echo
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
