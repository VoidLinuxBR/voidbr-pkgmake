#!/usr/bin/env bash
# Maintainer: Wiljapa <wilton.kikkawa@gmail.com>

pkgname=adw-gtk-theme
pkgver=6.5
pkgrel=1
pkgdesc="Tema GTK3 não oficial, port do libadwaita (usado pelo template GTK do Noctalia)"
arch=('any')
url="https://github.com/lassekongo83/adw-gtk3"
license=('LGPL-2.1-only')
depends=('gtk+3')
makedepends=('meson' 'ninja')
# o upstream exige o dart-sass ('sass'), que o Void não empacota: usa o binário oficial só no build
_sass_ver=1.105.1
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
	"dart-sass-$_sass_ver.tar.gz::https://github.com/sass/dart-sass/releases/download/$_sass_ver/dart-sass-$_sass_ver-linux-x64.tar.gz")
sha256sums=('fc9fc3b3e89d90d9a0e38bae05445ce9e65faf47acea3ac658e5f42566def473'
	'9046fdd4a31a524a0020298c55d9e155d4c22363ef268e8992574335a72c6a6f')

build() {
	export PATH="$srcdir/dart-sass:$PATH"
	cd "adw-gtk3-$pkgver"
	meson setup build --prefix=/usr
	meson compile -C build
}

package() {
	cd "adw-gtk3-$pkgver"
	DESTDIR="$pkgdir" meson install -C build
	[ -f LICENSE ] && install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}
