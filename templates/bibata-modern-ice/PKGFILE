package() {
	# Cria a pasta do tema dentro do pacote (/usr/share/icons/Bibata-Modern-Ice)
	install -dm755 "${pkgdir}/usr/share/icons/Bibata-Modern-Ice"

	# O pkgmake extrai tudo no ${srcdir}. Como esse tarball não tem uma pasta raiz própria,
	# nós copiamos os arquivos extraídos com segurança.
	cp -a "${srcdir}/Bibata-Modern-Ice/cursors" "${pkgdir}/usr/share/icons/Bibata-Modern-Ice/"
	cp -a "${srcdir}/Bibata-Modern-Ice/cursor.theme" "${pkgdir}/usr/share/icons/Bibata-Modern-Ice/"
	cp -a "${srcdir}/Bibata-Modern-Ice/index.theme" "${pkgdir}/usr/share/icons/Bibata-Modern-Ice/"
}

