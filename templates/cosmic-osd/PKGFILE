pkgname=cosmic-osd
pkgver=1.10.0
pkgrel=1
epoch=1
pkgdesc='COSMIC On-Screen Display'
arch=(x86_64)
url=https://github.com/pop-os/cosmic-osd
license=(GPL-3.0-only)
groups=(cosmic)
# NOTE: depends original (arch): libgcc glibc libinput libpipewire libpulse libxkbcommon sound-theme-freedesktop systemd-libs wayland
depends=(
	'libgcc'
	'glibc'
	'libinput'
	'libpipewire'
	'libpulseaudio'
	'libxkbcommon'
	'sound-theme-freedesktop'
	'wayland'
)
# NOTE: makedepends original (arch): cargo clang git just lld
makedepends=(
	'libinput-devel'
	'pulseaudio-devel'
	'libxkbcommon-devel'
	'wayland-devel'
	'cargo'
	'clang'
	'clang21-devel' # VoidBR: libclang.so (bindgen/clang-sys); no Arch vem no clang
	'git'
	'just'
	'lld'
)
source=(
	git+https://github.com/pop-os/cosmic-osd.git#tag=epoch-${pkgver}
)
b2sums=('195c8b35746d534b01dd9db72160972225e9acc93e6fd490ba4f90c07423c5e520921036c64f9b09ed5b68e9c04c0e443ca0da2ca5efad92c884ae909987135c')

prepare() {
	cd cosmic-osd
	cargo fetch --locked
}

build() (
	export RUSTFLAGS+=" -C link-arg=-fuse-ld=lld"
	cd cosmic-osd
	just build-release
)

package() {
	cd cosmic-osd
	just rootdir="${pkgdir}" install
}

# vim: ts=2 sw=2 et:

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
