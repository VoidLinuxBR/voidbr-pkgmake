pkgbase=bcachefs-tools
pkgname=bcachefs-dkms
epoch=3
pkgver=1.39.0
pkgrel=2
pkgdesc='BCacheFS filesystem utilities'
arch=('x86_64')
url='https://bcachefs.org/'
license=('GPL-2.0-only')
makedepends=(
	fuse3
	glibc
	keyutils-devel
	libaio-devel
	libgcc
	libsodium-devel
	libunwind
	liburcu-devel
	lz4
	#	systemd-libs
	#	udev
	util-linux-libs
	zlib
	zstd
	rust
	rust-bindgen
	clang
	git
	jq
	llvm
	pkgconf
	valgrind
)
options=(!lto)
source=(
	git+https://github.com/koverstreet/bcachefs-tools.git#tag=v${pkgver}
	0001-do-not-load-binary-modules-for-dkms-package.patch
)
b2sums=('fe338be6a7b2937bf711541984145dc902ab3c8b33111d79fb1985e753c8077d7cdf5a0739c650ca8e259524cac412a0fdfcba3067b9f2f9b1a005fe54cf5ed5'
	'55cc2148c23a18f1d286fb77941a03b41ee4b3748728e517e5af06ec88fab41262c67b603907b0da8319bc5f08ff1667edc1480284bd4d3aca72c5412cb68e9f')
depends=(
	bash
	dkms
	rust
	rust-bindgen
)

prepare() {
  cd ${srcdir}/${pkgbase}
	patch -Np1 <../0001-do-not-load-binary-modules-for-dkms-package.patch
}

build() {
  cd ${srcdir}/${pkgbase}

	# this uses malloc_usable_size, which is incompatible with fortification level 3
	# https://github.com/koverstreet/bcachefs-tools/issues/237
	export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
	export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

	make \
		LIBEXECDIR=/usr/lib \
		DESTDIR="${pkgdir}" \
		ROOT_SBINDIR="/usr/bin" \
		INITRAMFS_DIR="/usr/lib/initcpio/"
}


package() {
  cd ${srcdir}/${pkgbase}

  make \
    PREFIX="/usr" \
    LIBEXECDIR=/usr/lib \
    DESTDIR="${pkgdir}" \
    ROOT_SBINDIR="/usr/bin" \
    INITRAMFS_DIR="/usr/lib/initcpio/" \
    install_dkms
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
