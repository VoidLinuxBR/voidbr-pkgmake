PKGDEST=""
CLI_PKGDEST=""

PACKAGER=""
CLI_PACKAGER=""

REINDEX_FORCE="${REINDEX_FORCE:-0}"
CLI_REINDEX=
REINDEX_ONLY=false
REINDEX_ALL=false
PRINTCONFIG=0
IS_INSTALL_CREATED=false
IS_REMOVE_CREATED=false

# Sites globais (compatibilidade xbps-src)
DEBIAN_SITE="https://deb.debian.org/debian"

# Colors: prefer tput, fallback to ANSI
if command -v tput >/dev/null 2>&1 && tput sgr0 >/dev/null 2>&1; then
	reset="$(tput sgr0)"
	rst="$(tput sgr0)"
	bold="$(tput bold)"
	black="$(tput bold)$(tput setaf 0)"
	red="$(tput setaf 1)"
	green="$(tput setaf 2)"
	yellow="$(tput setaf 3)"
	blue="$(tput setaf 4)"
	magenta="$(tput setaf 5)"
