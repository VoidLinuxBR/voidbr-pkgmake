	reset='\033[0m'
	rst='\033[0m'
	black='\033[0;30m'
	red='\033[0;31m'
	green='\033[0;32m'
	yellow='\033[0;33m'
	blue='\033[0;34m'
	magenta='\033[0;35m'
	cyan='\033[0;36m'
	white='\033[0;37m'
	bold='\033[1m'
	pink='\033[95m'
fi

validate_pkgname() {
	local cname="$1"

	[[ -z "$cname" ]] && return 1
	if [[ ! "$cname" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
		return 1
	fi
	return 0
}

pkgmake_new() {
	# pkgmake new — create PKGFILE skeleton or import from Arch/Void
	local PKGNAME=""
	local MODE="skeleton"
	local DIRPKGFILE='local'

	# -------- argumentos --------
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--from-arch)
			MODE="arch"
			shift
			;;
		--from-voidlinuxbr)
			MODE="voidlinuxbr"
			shift
			;;
		--from-void)
			MODE="void"
			shift
			;;
		--from-venom)
			MODE="venom"
			shift
			;;
		--from-alpine)
			MODE="alpine"
			shift
			;;
		--from-fedora)
			MODE="fedora"
			shift
			;;
		--from-debian)
			MODE="debian"
			shift
			;;
		-*)
			die "opção inválida: $1"
			;;
		*)
			PKGNAME="$1"
			shift
			;;
		esac
	done

	[[ -z "$PKGNAME" ]] &&
		die "nome do pacote não informado"

	validate_pkgname "$PKGNAME" ||
		die "nome de pacote inválido: '$PKGNAME' (use apenas letras, números, '.', '_' ou '-')"

	[[ "$MODE" != "skeleton" ]] && DIRPKGFILE="$MODE"
	DIRPKGFILE+="-${PKGNAME}"
	[[ -e "${DIRPKGFILE}" ]] &&
		die "diretório '$DIRPKGFILE' já existe"

	case "$MODE" in
	arch)
		from_arch "$PKGNAME" "${DIRPKGFILE}"
		;;
	voidlinuxbr)
		from_voidlinuxbr "$PKGNAME" "${DIRPKGFILE}"
		;;
	void)
		from_void "$PKGNAME" "${DIRPKGFILE}"
		;;
	skeleton)
		from_skeleton "$PKGNAME" "${DIRPKGFILE}"
		;;
	venom)
		from_venom "$PKGNAME" "${DIRPKGFILE}"
		;;
	alpine)
		from_alpine "$PKGNAME" "${DIRPKGFILE}"
		;;
	fedora)
		from_fedora "$PKGNAME" "${DIRPKGFILE}"
		;;
	debian)
		from_debian "$PKGNAME" "${DIRPKGFILE}"
		;;
	*)
		die "modo interno inválido"
		;;
	esac
}

from_venom() {
	local PKGNAME="$1"
	local DIRPKGFILE="$2"
	local pkg repo
	local found=0
	local depends_line depends_array
	local desc_line pkgdesc

	local VENOM_REPOS=(
		core
		main
		multilib
		nonfree
		scripts
		testing
		archived
	)

	mkdir -p "${DIRPKGFILE}"
	cd "${DIRPKGFILE}" || die "não foi possível entrar no diretório '${DIRPKGFILE} '"
	msg "Fetch package from Venom Linux ports"

	# Parse: vim  OU  core/vim
	if [[ "$PKGNAME" == */* ]]; then
		repo="${PKGNAME%%/*}"
		pkg="${PKGNAME##*/}"
		VENOM_REPOS=("$repo")
	else
		pkg="$PKGNAME"
	fi

	TMP="$(mktemp -d)"
	trap 'rm -rf "$TMP"' EXIT

	git clone --depth=1 \
		https://github.com/venomlinux/ports.git \
		"$TMP/ports" >/dev/null 2>&1 ||
		die "falha ao clonar venomlinux/ports"

	for repo in "${VENOM_REPOS[@]}"; do
		local srcdir="$TMP/ports/$repo/$pkg"

		[[ -d "$srcdir" ]] || continue
		[[ -f "$srcdir/spkgbuild" ]] || continue

		found=1
		msg "Package found: $repo/$pkg"

		# description
		desc_line="$(grep -E '^# description[[:space:]]*:' "$srcdir/spkgbuild" || true)"
		if [[ -n "$desc_line" ]]; then
			pkgdesc="$(printf '%s\n' "$desc_line" |
				sed -E 's/^# description[[:space:]]*:[[:space:]]*//')"
		else
			pkgdesc=""
		fi

		# depends
		depends_line="$(grep -E '^# depends[[:space:]]*:' "$srcdir/spkgbuild" || true)"
		if [[ -n "$depends_line" ]]; then
			depends_array="$(printf '%s\n' "$depends_line" |
				sed -E 's/^# depends[[:space:]]*:[[:space:]]*//')"
			depends_array="(${depends_array})"
		else
			depends_array="()"
		fi

		for f in "$srcdir"/*; do
			case "$(basename "$f")" in
			spkgbuild)
				{
					echo "#!/usr/bin/env bash"
					echo "# Maintainer: $PACKAGER"
					echo "# NOTE: Imported from Venom Linux"
					echo "# NOTE: Source: https://github.com/venomlinux/ports/$repo/$pkg"
					echo "# NOTE: This PKGFILE is PARTIAL and MUST be reviewed"

					awk -v dep="depends=${depends_array}" \
						-v desc="$pkgdesc" '
                     BEGIN {
                        dep_inserted=0
                        desc_inserted=0
                     }

                     /^# description[[:space:]]*:/ { next }
                     /^# depends[[:space:]]*:/ { next }

                     /^name=/ {
                        print
                        sub(/^name=/, "pkgname=")
                        print
                        next
                     }

                     /^version=/ {
                        print
                        sub(/^version=/, "pkgver=")
                        print
                        next
                     }

                     /^release=/ {
                        print
                        sub(/^release=/, "pkgrel=")
                        print
                        print "build_style=venom"
                        if (desc != "" && !desc_inserted) {
                           print "pkgdesc=\"" desc "\""
                           desc_inserted=1
                        }
                        next
                     }

                     /^source=/ && !dep_inserted {
                        print
                        print dep
                        dep_inserted=1
                        next
                     }

                     { print }

                     END {
                        if (desc != "" && !desc_inserted) {
                           print "pkgdesc=\"" desc "\""
                        }
                        if (!dep_inserted) {
                           print dep
                        }
                     }
                  ' "$f"
					sh_pre_post_install
				} >PKGFILE
				;;
			*)
				cp -av "$f" .
				;;
			esac
		done

		translate_pkgfile_deps venom PKGFILE
		shfmt -w PKGFILE
		msg "PKGFILE criado com sucesso."
		msg "Entre no diretório com: cd ${DIRPKGFILE}"
		msg "Revisão manual obrigatória."
		exit 0
	done

	die "package '$pkg' not found in Venom ports"
}

from_skeleton() {
	local PKGNAME="$1"
	local DIRPKGFILE="$2"

	mkdir -p "${DIRPKGFILE}" || die "não foi possível criar diretório '${DIRPKGFILE} '"
	cd "${DIRPKGFILE}" || die "não foi possível entrar no diretório '${DIRPKGFILE} '"

	cat >PKGFILE <<EOF
# PKGFILE skeleton - Generated by pkgmake new
# NOTE: This PKGFILE MUST be reviewed and completed before use
#
# Maintainer: $(whoami) <$(whoami)@gmail.com>

pkgname=$PKGNAME
pkgver=\$(date +%Y%m%d)
pkgrel=\$(date +%H%M)
pkgdesc="Pacote exemplo"
provides=()
replaces=()
conflicts=()
#build_style=local                     #local
#build_style=venom                     #pacotes from venom
#build_style=gnu-configure             #void
license=('MIT')
homepage="https://homepage.com"
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/\${pkgname}"
source=("git+\${url}.git")
#source=('https://homepage.com/file.tar.gz')
checksum=('SKIP')
makedepends=()
depends=('bash>=0')
backup=()

prepare() {
  :
}

build() {
  :
}

package() {
  # Verify default folder
  if [ -d "\${srcdir}/\${pkgname}/\${pkgname}" ]; then
    InternalDir="\${srcdir}/\${pkgname}/\${pkgname}"
  else
    InternalDir="\${srcdir}/\${pkgname}"
  fi

  cd "\${srcdir}/\${pkgname}"
  # Copiar a estrutura de /etc, /usr e /opt para /
  local dirs=("boot" "etc" "opt" "usr")
  for dir in "\${dirs[@]}"; do
    if [ -d "\${InternalDir}/\${dir}" ]; then
      cp -a "\${InternalDir}/\${dir}" "\${pkgdir}/"
    fi
  done

  # Install license file if present
  if [ -f "LICENSE" ]; then
    install -Dm644 LICENSE "\${pkgdir}/usr/share/licenses/\${pkgname}/LICENSE"
  fi

  # Install documentation if present
  if [ -f "README.md" ]; then
    install -Dm644 README.md "\${pkgdir}/usr/share/doc/\${pkgname}/README.md"
  fi
}

pre_install() {
  log "Iniciando instalação"
}

post_install() {
  log "Finalizando instalação"
}

pre_upgrade() {
  log "Iniciando upgrade"
}

post_upgrade() {
  log "Finalizando upgrade"
}

EOF

	cd - >/dev/null || true

	msg "PKGFILE criado com sucesso."
	msg "Entre no diretório com: cd $DIRPKGFILE"
	msg "Revisão manual obrigatória."
}

from_voidlinuxbr() {
	local PKGNAME="$1"
	local DIRPKGFILE="$2"
	local REPO_URL="https://raw.githubusercontent.com/voidlinuxbr/pkgmake/main"
	local TMP
	TMP="$(mktemp -d)"
	trap 'rm -rf -- "$TMP"' EXIT

	msg "Importando template VoidLinuxBR: $PKGNAME"
	msg "Fonte: https://github.com/voidlinuxbr/pkgmake"

	# Escolhe downloader
	if command -v curl >/dev/null 2>&1; then
		DL="curl -fsSL"
	elif command -v wget >/dev/null 2>&1; then
		DL="wget -qO-"
	else
		die "necessário 'curl' ou 'wget' para download"
	fi

	# Baixa template do VoidLinuxBR
	if ! $DL "$REPO_URL/templates/$PKGNAME/PKGFILE" >"$TMP/PKGFILE" 2>/dev/null; then
		[[ -n "$TMP" && "$TMP" != "/" ]] || die "TMP inválido"
		rm -rf -- "$TMP"
		die "template VoidLinuxBR não encontrado para pacote '$PKGNAME'"
	fi

	# Cria diretório do pacote
	mkdir -p "${DIRPKGFILE}"
	cd "${DIRPKGFILE}" || die "não foi possível entrar no diretório '${DIRPKGFILE} '"

	# Gera PKGFILE com aviso explícito
	{
		cat "$TMP/PKGFILE"
	} >PKGFILE

	cd - >/dev/null || true
	[[ -n "$TMP" && "$TMP" != "/" ]] || die "TMP inválido"
	rm -rf -- "$TMP"

	msg "PKGFILE criado com sucesso."
	msg "Entre no diretório com: cd $DIRPKGFILE"
	msg "Revisão manual obrigatória."
}

sh_pre_post_install() {
	{
		echo 'pre_install() {'
		echo '  log "Iniciando instalação"'
		echo '}'
		echo
		echo 'post_install() {'
		echo '  log "Finalizando instalação"'
		echo '}'
		echo
		echo 'pre_upgrade() {'
		echo '  log "Iniciando upgrade"'
		echo '}'
		echo
		echo 'post_upgrade() {'
		echo '  log "Finalizando upgrade"'
		echo '}'
	}
}

# -------------------------------------------------------------------
# helpers comuns dos importadores (Alpine/Fedora/Debian)
# -------------------------------------------------------------------
import_dl() {
	curl -fsSL --retry 2 -- "$1"
}

# gera a lista bash 'a' 'b' (aspas simples) a partir dos argumentos
bash_list() {
	local i out=""
	for i in "$@"; do
		out+="'${i//\'/\'\\\'\'}' "
	done
	echo "${out% }"
}

import_gitignore() {
	{
		echo "pkg/"
		echo "src/"
	} >.gitignore
}

import_finish() {
	local dir="$1"
	shfmt -w PKGFILE 2>/dev/null || true
	cd - >/dev/null || true
	msg "${dir}/PKGFILE criado com sucesso."
	msg "Entre no diretório: ${yellow}cd $dir${rst}"
	msg "Revisão manual obrigatória."
}

# -------------------------------------------------------------------
# new --from-alpine <pkgname>   (ou main/pkg, community/pkg, testing/pkg)
# Importa APKBUILD do Alpine Linux (aports, espelho do GitHub)
# -------------------------------------------------------------------
from_alpine() {
	local PKGNAME="$1" DIRPKGFILE="$2"
	local ALPINE_RAW="https://raw.githubusercontent.com/alpinelinux/aports/master"
	local repos=(main community testing) repo pkg found="" s f
	local TMP

	if [[ "$PKGNAME" == */* ]]; then
		repos=("${PKGNAME%%/*}")
		pkg="${PKGNAME##*/}"
	else
		pkg="$PKGNAME"
	fi

	TMP="$(mktemp -d)"
	trap 'rm -rf -- "$TMP"' EXIT

	msg "Procurando APKBUILD no Alpine: $pkg"
	for repo in "${repos[@]}"; do
		if import_dl "$ALPINE_RAW/$repo/$pkg/APKBUILD" >"$TMP/APKBUILD" 2>/dev/null; then
			found="$repo"
			break
		fi
	done
	[[ -n "$found" ]] || die "APKBUILD não encontrado no Alpine para '$pkg' (repos: ${repos[*]})"
	msg "Pacote encontrado: $found/$pkg"

	mkdir -p "$DIRPKGFILE"
	cd "$DIRPKGFILE" || die "não foi possível entrar no diretório '$DIRPKGFILE'"

	# lê as variáveis do APKBUILD num subshell sem rede/efeitos (só atribuições)
	local meta
	meta="$(
		cd "$TMP" &&
			env -i PATH=/usr/bin:/bin bash -c '
				CBUILD=x CHOST=x CARCH=x CTARGET=x srcdir=/src pkgdir=/pkg startdir=/start
				source ./APKBUILD >/dev/null 2>&1 || true
				for v in pkgname pkgver pkgrel pkgdesc url license builddir; do
					printf "%s=%q\n" "$v" "${!v}"
				done
				printf "a_depends=%q\n" "$depends"
				printf "a_makedepends=%q\n" "$makedepends $makedepends_build $makedepends_host"
				printf "a_source=%q\n" "$source"
				printf "a_install=%q\n" "$install"
			'
	)" || die "falha ao ler o APKBUILD"

	local pkgname pkgver pkgrel pkgdesc url license builddir a_depends a_makedepends a_source a_install
	eval "$meta"

	# fontes: URLs ficam no source; arquivos locais (patches etc.) são baixados
	local srcs=() locals=() patches=()
	for s in $a_source; do
		if [[ "$s" == *://* ]]; then
			srcs+=("$s")
		else
			f="${s##*::}"
			if import_dl "$ALPINE_RAW/$found/$pkg/$f" >"$f" 2>/dev/null; then
				locals+=("$f")
				[[ "$f" == *.patch ]] && patches+=("$f")
			else
				rm -f "$f"
				warn "arquivo local do APKBUILD não encontrado: $f"
			fi
		fi
	done
	# scripts de instalação do Alpine (.pre-install, .post-install...) ficam só para referência
	for s in $a_install; do
		import_dl "$ALPINE_RAW/$found/$pkg/$s" >"$s" 2>/dev/null || rm -f "$s"
	done

	# funções do APKBUILD (renomeadas para _alpine_*), sem as dos subpacotes
	local fns
	fns="$(
		cd "$TMP" &&
			env -i PATH=/usr/bin:/bin bash -c '
				source ./APKBUILD >/dev/null 2>&1 || true
				# variáveis auxiliares do APKBUILD (_commit, _pkgver...)
				for v in $(compgen -v | grep -E "^_[A-Za-z0-9]"); do
					printf "%s=%q\n" "$v" "${!v}"
				done
				echo
				for fn in prepare build check package; do
					declare -F "$fn" >/dev/null && declare -f "$fn" | sed "1s/^$fn /_alpine_$fn /"
				done
			'
	)"

	[[ -n "$builddir" && "$builddir" != "/src/" ]] || builddir="/src/$pkgname-$pkgver"
	builddir="${builddir/#\/src/\$srcdir}"

	{
		echo "#!/usr/bin/env bash"
		echo "# NOTE: Imported from Alpine Linux ($found/$pkg)"
		echo "# NOTE: Source: https://gitlab.alpinelinux.org/alpine/aports/-/tree/master/$found/$pkg"
		echo "# NOTE: This PKGFILE is PARTIAL and MUST be reviewed"
		echo "# Maintainer: $PACKAGER"
		echo
		echo "pkgname=$pkgname"
		echo "pkgver=$pkgver"
		echo "pkgrel=$((pkgrel + 1))"
		echo "pkgdesc=$(bash_list "$pkgdesc")"
		echo "url=$(bash_list "$url")"
		echo "arch=('x86_64')"
		printf 'license=(%s)\n' "$(bash_list "$license")"
		echo "source=($(bash_list "${srcs[@]}" "${locals[@]}"))"
		echo "md5sums=('SKIP')"
		[[ -n "$a_install" ]] && echo "# NOTE: Alpine install scripts (revisar e passar para pre/post_install): $a_install"
		echo
		echo "# ambiente esperado pelas funções do Alpine"
		echo "CBUILD=\"\$(gcc -dumpmachine)\""
		echo "CHOST=\"\$CBUILD\""
		echo "CARCH=\"\$(uname -m)\""
		echo "builddir=\"$builddir\""
		echo
		echo "default_prepare() {"
		echo "	local p"
		echo "	for p in $(bash_list "${patches[@]}"); do"
		echo "		msg \"Aplicando patch: \$p\""
		echo "		patch -p1 -i \"\$srcdir/\$p\""
		echo "	done"
		echo "}"
		echo
		echo "$fns"
		echo
		if grep -q '^_alpine_prepare ' <<<"$fns"; then
			echo 'prepare() { cd "$builddir" && _alpine_prepare; }'
		else
			echo 'prepare() { cd "$builddir" && default_prepare; }'
		fi
		grep -q '^_alpine_build ' <<<"$fns" && echo 'build() { cd "$builddir" && _alpine_build; }'
		grep -q '^_alpine_package ' <<<"$fns" && echo 'package() { cd "$builddir" && _alpine_package; }'
		echo
		sh_pre_post_install
	} >PKGFILE

	mapfile -t IN_DEPS < <(tr -s ' \t' '\n\n' <<<"$a_depends" | sed '/^$/d')
	mapfile -t IN_MDEPS < <(tr -s ' \t' '\n\n' <<<"$a_makedepends" | sed '/^$/d')
	write_translated_deps alpine PKGFILE
	import_gitignore
	import_finish "$DIRPKGFILE"
}

# -------------------------------------------------------------------
# new --from-fedora <pkgname>
# Importa o .spec do Fedora (src.fedoraproject.org, rawhide)
# -------------------------------------------------------------------

# expande macros %{...} conhecidas de uma linha do .spec
fedora_expand() {
	local l="$1" k
	for k in "${!FEDORA_MACROS[@]}"; do
		l="${l//"%{$k}"/"${FEDORA_MACROS[$k]}"}"
		l="${l//"%{?$k}"/"${FEDORA_MACROS[$k]}"}"
		l="${l//"%$k"/"${FEDORA_MACROS[$k]}"}"
	done
	l="${l//"%{?dist}"/}"
	echo "$l"
}

# converte uma linha de %build/%install para shell
FEDORA_SUBST=(
	'%{buildroot}' '$pkgdir'
	'$RPM_BUILD_ROOT' '$pkgdir'
	'%{_prefix}' '/usr'
	'%{_bindir}' '/usr/bin'
	'%{_sbindir}' '/usr/bin'
	'%{_libdir}' '/usr/lib'
	'%{_libexecdir}' '/usr/libexec'
	'%{_includedir}' '/usr/include'
	'%{_datadir}' '/usr/share'
	'%{_mandir}' '/usr/share/man'
	'%{_infodir}' '/usr/share/info'
	'%{_docdir}' '/usr/share/doc'
	'%{_sysconfdir}' '/etc'
	'%{_localstatedir}' '/var'
	'%{_unitdir}' '/usr/lib/systemd/system'
	'%{?_smp_mflags}' '-j$(nproc)'
	'%{_smp_mflags}' '-j$(nproc)'
	'%{optflags}' '$CFLAGS'
	'%{build_ldflags}' '$LDFLAGS'
	'%{__python3}' 'python3'
	'%{python3}' 'python3'
	'%{__make}' 'make'
	'%{__cmake}' 'cmake'
	'%configure' './configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --mandir=/usr/share/man --infodir=/usr/share/info'
	'%make_build' 'make -j$(nproc)'
	'%make_install' 'make install DESTDIR="$pkgdir"'
	'%cmake_build' 'cmake --build build'
	'%cmake_install' 'DESTDIR="$pkgdir" cmake --install build'
	'%cmake' 'cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release'
	'%meson_build' 'meson compile -C build'
	'%meson_install' 'DESTDIR="$pkgdir" meson install -C build'
	'%meson' 'meson setup build --prefix=/usr --buildtype=release'
	'%pyproject_wheel' 'python3 -m build --wheel --no-isolation'
	'%pyproject_install' 'python3 -m installer --destdir="$pkgdir" dist/*.whl'
	'%py3_build' 'python3 setup.py build'
	'%py3_install' 'python3 setup.py install --root="$pkgdir" --optimize=1'
)

fedora_shell_line() {
	local l a b i pat
	l="$(fedora_expand "$1")"
	for ((i = 0; i < ${#FEDORA_SUBST[@]}; i += 2)); do
		a="${FEDORA_SUBST[i]}"
		b="${FEDORA_SUBST[i + 1]}"
		l="${l//"$a"/"$b"}"
	done
	# %global _configure ../configure (build fora da árvore)
	[[ -n "${FEDORA_MACROS[_configure]:-}" ]] && l="${l//"./configure --prefix"/"${FEDORA_MACROS[_configure]} --prefix"}"
	# %{SOURCEn} -> arquivo copiado para o srcdir
	while [[ "$l" =~ %\{?SOURCE([0-9]+)\}? ]]; do
		pat="${BASH_REMATCH[0]}"
		b="\$srcdir/${FEDORA_SRC[${BASH_REMATCH[1]}]##*/}"
		l="${l//"$pat"/"$b"}"
	done

	case "$l" in
	%find_lang* | %pyproject_save_files* | %ldconfig* | %set_build_flags* | %py3_shebang_fix* | %\{?ldconfig*)
		echo "	# $l"
		return 0
		;;
	%if* | %else* | %endif* | %global* | %define* | %bcond*)
		echo "	# NOTE(revisar): $l"
		return 0
		;;
	esac
	if [[ "$l" =~ %[a-zA-Z_{] ]]; then
		echo "	# NOTE(revisar macro): $l"
		return 0
	fi
	echo "	$l"
}

from_fedora() {
	local PKGNAME="$1" DIRPKGFILE="$2"
	local REPO_URL="https://src.fedoraproject.org/rpms/${PKGNAME}.git"
	local spec line tag val section="" k n sub
	local name="" version="" release="" summary="" license="" url="" setupdir=""
	local deps=() mdeps=() patches=() srcs=() locals=() buildl=() installl=() prepl=() toks=()
	declare -gA FEDORA_MACROS=() FEDORA_SRC=()

	git ls-remote --exit-code "$REPO_URL" &>/dev/null ||
		die "pacote '$PKGNAME' não encontrado no Fedora ($REPO_URL)"

	cmd_run git clone --depth=1 "$REPO_URL" "$DIRPKGFILE" ||
		die "erro ao clonar '$PKGNAME' do Fedora"
	cd "$DIRPKGFILE" || die "não foi possível entrar no diretório '$DIRPKGFILE'"
	rm -rf .git
	spec="${PKGNAME}.spec"
	[[ -f "$spec" ]] || spec="$(ls ./*.spec 2>/dev/null | head -n1)"
	[[ -f "$spec" ]] || die ".spec não encontrado"

	# %global/%define simples (nome valor)
	while read -r tag k val; do
		[[ -n "$k" && -n "$val" && "$val" != *%\(* ]] || continue
		FEDORA_MACROS["$k"]="$val"
	done < <(grep -E '^%(global|define)[[:space:]]' "$spec")

	sub=0 # dentro de %package de subpacote
	while IFS= read -r line || [[ -n "$line" ]]; do
		case "$line" in
		# %prep antes de %pre*: senão "%prep" casaria com "%pre*"
		%prep*) section="prep" ; continue ;;
		%build*) section="build" ; continue ;;
		%install*) section="install" ; continue ;;
		%package*) sub=1 section="" ; continue ;;
		%description* | %files* | %changelog* | %pre* | %post* | %check* | %preun* | %postun* | %posttrans*)
			section="skip"
			continue
			;;
		esac

		case "$section" in
		build) buildl+=("$line"); continue ;;
		install) installl+=("$line"); continue ;;
		prep)
			if [[ "$line" =~ ^%(autosetup|setup).*-n[[:space:]]+([^[:space:]]+) ]]; then
				setupdir="${BASH_REMATCH[2]}"
			elif [[ "$line" != %autosetup* && "$line" != %setup* && "$line" != %autopatch* && "$line" != %patch* ]]; then
				prepl+=("$line")
			fi
			continue
			;;
		skip) continue ;;
		esac

		# Requires(post) etc. são dos scriptlets do rpm
		[[ "$line" =~ ^Requires\( ]] && continue
		[[ "$line" =~ ^([A-Za-z]+[0-9]*):[[:space:]]*(.*)$ ]] || continue
		tag="${BASH_REMATCH[1]}"
		val="$(fedora_expand "${BASH_REMATCH[2]}")"
		case "$tag" in
		Name) name="$val"; FEDORA_MACROS[name]="$val"; FEDORA_MACROS[NAME]="$val" ;;
		Version) version="$val"; FEDORA_MACROS[version]="$val"; FEDORA_MACROS[VERSION]="$val" ;;
		Release) release="${val%%%*}"; release="${release%%.*}" ;;
		Summary) ((sub)) || summary="$val" ;;
		License) ((sub)) || license="$val" ;;
		URL) url="$val"; FEDORA_MACROS[url]="$val"; FEDORA_MACROS[URL]="$val" ;;
		Source*)
			n="${tag#Source}"
			n="${n:-0}"
			FEDORA_SRC["$n"]="$val"
			if [[ "$val" == *://* ]]; then
				srcs+=("$val")
			elif [[ -f "${val##*/}" ]]; then
				locals+=("${val##*/}")
			else
				warn "Source do .spec não resolvido: $val"
			fi
			;;
		Patch*)
			if [[ "$val" == *://* ]]; then
				srcs+=("$val")
				patches+=("${val##*/}")
			elif [[ -f "${val##*/}" ]]; then
				locals+=("${val##*/}")
				patches+=("${val##*/}")
			fi
			;;
		BuildRequires)
			read -r -a toks <<<"$(echo "$val" | sed -E 's/[[:space:]]*(>=|<=|=|>|<)[[:space:]]*/\1/g; s/,/ /g')"
			mdeps+=("${toks[@]}")
			;;
		Requires)
			((sub)) && continue
			read -r -a toks <<<"$(echo "$val" | sed -E 's/[[:space:]]*(>=|<=|=|>|<)[[:space:]]*/\1/g; s/,/ /g')"
			deps+=("${toks[@]}")
			;;
		esac
	done <"$spec"

	[[ -n "$name" && -n "$version" ]] || die "não consegui ler Name/Version do .spec"
	# Requires do próprio pacote (ex.: nano = %{version}) não fazem sentido aqui
	local d clean=()
	for d in "${deps[@]}"; do
		[[ "$d" == "$name"* || "$d" == *%* ]] && continue
		clean+=("$d")
	done
	deps=("${clean[@]}")
	clean=()
	for d in "${mdeps[@]}"; do
		[[ "$d" == *%* ]] && continue
		clean+=("$d")
	done
	mdeps=("${clean[@]}")

	[[ -n "$setupdir" ]] || setupdir="$name-$version"
	setupdir="$(fedora_expand "$setupdir")"

	{
		echo "#!/usr/bin/env bash"
		echo "# NOTE: Imported from Fedora ($PKGNAME.spec, rawhide)"
		echo "# NOTE: Source: https://src.fedoraproject.org/rpms/$PKGNAME"
		echo "# NOTE: This PKGFILE is PARTIAL and MUST be reviewed (o .spec original fica ao lado)"
		echo "# Maintainer: $PACKAGER"
		echo
		echo "pkgname=$name"
		echo "pkgver=$version"
		echo "pkgrel=${release:-1}"
		echo "pkgdesc=$(bash_list "$summary")"
		echo "url=$(bash_list "$url")"
		echo "arch=('x86_64')"
		echo "license=($(bash_list "$license"))"
		echo "source=($(bash_list "${srcs[@]}" "${locals[@]}"))"
		echo "md5sums=('SKIP')"
		echo
		echo "prepare() {"
		echo "	cd \"\$srcdir/$setupdir\""
		echo "	local p"
		echo "	for p in $(bash_list "${patches[@]}"); do"
		echo "		msg \"Aplicando patch: \$p\""
		echo "		patch -p1 -i \"\$srcdir/\$p\""
		echo "	done"
		for line in "${prepl[@]}"; do
			[[ -n "$line" && "$line" != \#* ]] && fedora_shell_line "$line"
		done
		echo "}"
		echo
		echo "build() {"
		echo "	cd \"\$srcdir/$setupdir\""
		for line in "${buildl[@]}"; do
			[[ -n "$line" ]] && fedora_shell_line "$line"
		done
		echo "}"
		echo
		echo "package() {"
		echo "	cd \"\$srcdir/$setupdir\""
		for line in "${installl[@]}"; do
			[[ -n "$line" ]] && fedora_shell_line "$line"
		done
		echo "}"
		echo
		sh_pre_post_install
	} >PKGFILE

	IN_DEPS=("${deps[@]}")
	IN_MDEPS=("${mdeps[@]}")
	write_translated_deps fedora PKGFILE
	import_gitignore
	import_finish "$DIRPKGFILE"
}

# -------------------------------------------------------------------
# new --from-debian <pkgname>
# Importa o pacote fonte do Debian (sid) via sources.debian.org
# -------------------------------------------------------------------

# Build-Depends/Depends do debian/control -> tokens "nome>=versão"
debian_dep_tokens() {
	# junta continuações, tira alternativas (fica a 1ª), arch/profile e substvars
	tr '\n' ' ' |
		tr ',' '\n' |
		sed -E 's/\|.*$//; s/\[[^]]*\]//g; s/<[^>]*>//g; s/\$\{[^}]*\}//g; s/:any|:native//g' |
		sed -E 's/\(([<>=]+)[[:space:]]*([^)]*)\)/\1\2/; s/<</</; s/>>/>/' |
		tr -d ' \t' |
		sed '/^$/d'
}

from_debian() {
	local PKGNAME="$1" DIRPKGFILE="$2"
	local API="https://sources.debian.org" POOL="https://deb.debian.org/debian/pool/main"
	local json ver upver prefix data dsc f p style="autotools"
	local srcs=() patches=() bdeps=() rdeps=()

	command -v jq >/dev/null 2>&1 || die "jq necessário para importar do Debian"

	msg "Procurando pacote fonte no Debian: $PKGNAME"
	json="$(import_dl "$API/api/src/$PKGNAME/")" || die "falha ao consultar sources.debian.org"
	ver="$(jq -r '.versions[0].version // empty' <<<"$json")"
	[[ -n "$ver" ]] || die "pacote fonte '$PKGNAME' não encontrado no Debian"
	msg "Versão: $ver"

	data="$API/data/main/${PKGNAME:0:1}/$PKGNAME/$ver"
	prefix="${PKGNAME:0:1}"
	[[ "$PKGNAME" == lib* ]] && {
		prefix="${PKGNAME:0:4}"
		data="$API/data/main/$prefix/$PKGNAME/$ver"
	}

	mkdir -p "$DIRPKGFILE/debian"
	cd "$DIRPKGFILE" || die "não foi possível entrar no diretório '$DIRPKGFILE'"

	import_dl "$data/debian/control" >debian/control || die "debian/control não encontrado"
	import_dl "$data/debian/rules" >debian/rules 2>/dev/null || rm -f debian/rules

	# patches (quilt): debian/patches/series
	if import_dl "$data/debian/patches/series" >debian/series 2>/dev/null; then
		while read -r p _; do
			[[ -z "$p" || "$p" == \#* ]] && continue
			f="${p##*/}"
			if import_dl "$data/debian/patches/$p" >"$f" 2>/dev/null; then
				patches+=("$f")
			else
				rm -f "$f"
				warn "patch do Debian não encontrado: $p"
			fi
		done <debian/series
	else
		rm -f debian/series
	fi

	# tarball original: lido do .dsc
	upver="${ver#*:}"
	dsc="$(import_dl "$POOL/$prefix/$PKGNAME/${PKGNAME}_${upver}.dsc" 2>/dev/null || true)"
	f="$(sed -n '/^Files:/,/^[^ ]/p' <<<"$dsc" | awk '{print $3}' | grep -E '\.orig\.tar\.[a-z0-9]+$|^[^_]+_[^-]+\.tar\.[a-z0-9]+$' | head -n1)"
	if [[ -n "$f" ]]; then
		srcs+=("$POOL/$prefix/$PKGNAME/$f")
	else
		warn "tarball original não encontrado no .dsc; ajuste o source manualmente"
	fi
	upver="${upver%-*}"
	upver="${upver%%+dfsg*}"
	upver="${upver%%+ds*}"

	# dependências: Build-Depends do fonte e Depends do 1º pacote binário
	mapfile -t bdeps < <(
		awk '/^Build-Depends(-Arch|-Indep)?:/ {p=1; sub(/^[^:]*:/, ""); print; next}
		     p && /^[ \t]/ {print; next} {p=0}' debian/control | debian_dep_tokens
	)
	mapfile -t rdeps < <(
		awk '/^Package:/ {n++} n==1 && /^Depends:/ {p=1; sub(/^[^:]*:/, ""); print; next}
		     p && /^[ \t]/ {print; next} {p=0}' debian/control | debian_dep_tokens
	)

	# estilo de build pelo Build-Depends
	if printf '%s\n' "${bdeps[@]}" | grep -qE '^(meson|dh-sequence-meson)'; then
		style="meson"
	elif printf '%s\n' "${bdeps[@]}" | grep -qE '^cmake'; then
		style="cmake"
	elif printf '%s\n' "${bdeps[@]}" | grep -qE '^(dh-python|dh-sequence-python3|python3-setuptools|pybuild-plugin-pyproject)'; then
		style="python"
	fi

	local desc homepage
	desc="$(awk '/^Package:/ {n++} n==1 && /^Description:/ {sub(/^Description:[ \t]*/, ""); print; exit}' debian/control)"
	homepage="$(awk '/^Homepage:/ {sub(/^Homepage:[ \t]*/, ""); print; exit}' debian/control)"

	{
		echo "#!/usr/bin/env bash"
		echo "# NOTE: Imported from Debian ($PKGNAME $ver, sid)"
		echo "# NOTE: Source: https://sources.debian.org/src/$PKGNAME/$ver/"
		echo "# NOTE: This PKGFILE is PARTIAL and MUST be reviewed"
		echo "# NOTE: o Debian calcula boa parte do depends no build (\${shlibs:Depends}); confira o depends"
		echo "# NOTE: debian/rules e debian/control ficam em ./debian para referência (build_style detectado: $style)"
		echo "# Maintainer: $PACKAGER"
		echo
		echo "pkgname=$PKGNAME"
		echo "pkgver=$upver"
		echo "pkgrel=1"
		echo "pkgdesc=$(bash_list "$desc")"
		echo "url=$(bash_list "$homepage")"
		echo "arch=('x86_64')"
		echo "license=('custom')"
		echo "source=($(bash_list "${srcs[@]}" "${patches[@]}"))"
		echo "md5sums=('SKIP')"
		echo
		echo "_builddir() { cd \"\$srcdir/$PKGNAME-$upver\" 2>/dev/null || cd \"\$srcdir\"/*/; }"
		echo
		echo "prepare() {"
		echo "	_builddir"
		echo "	local p"
		echo "	for p in $(bash_list "${patches[@]}"); do"
		echo "		msg \"Aplicando patch: \$p\""
		echo "		patch -p1 -i \"\$srcdir/\$p\""
		echo "	done"
		echo "}"
		echo
		case "$style" in
		meson)
			echo 'build() { _builddir; meson setup build --prefix=/usr --buildtype=release; meson compile -C build; }'
			echo 'package() { _builddir; DESTDIR="$pkgdir" meson install -C build; }'
			;;
		cmake)
			echo 'build() { _builddir; cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release; cmake --build build; }'
			echo 'package() { _builddir; DESTDIR="$pkgdir" cmake --install build; }'
			;;
		python)
			echo 'build() { _builddir; python3 -m build --wheel --no-isolation; }'
			echo 'package() { _builddir; python3 -m installer --destdir="$pkgdir" dist/*.whl; }'
			;;
		*)
			echo 'build() {'
			echo '	_builddir'
			echo '	[ -x configure ] || autoreconf -fi'
			echo '	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --mandir=/usr/share/man --infodir=/usr/share/info'
			echo '	make'
			echo '}'
			echo 'package() { _builddir; make DESTDIR="$pkgdir" install; }'
			;;
		esac
		echo
		sh_pre_post_install
	} >PKGFILE

	IN_DEPS=("${rdeps[@]}")
	IN_MDEPS=("${bdeps[@]}")
	write_translated_deps debian PKGFILE
	import_gitignore
	import_finish "$DIRPKGFILE"
}

# -------------------------------------------------------------------
# new --from-arch <pkgname>
# Importa template oficial do Arch Linux
# -------------------------------------------------------------------
from_arch() {
	local PKGNAME="$1"
	local JSON
	local PKGBASE
	local REPO_URL
	local DESTDIR="arch-$PKGNAME"

	[[ -z "$PKGNAME" ]] && die "Uso: new --from-arch <pkgname>"
	[[ -e "$DESTDIR" ]] && die "Diretório '$DESTDIR' já existe"

	msg "Procurando pacote: $PKGNAME"

	JSON="$(curl -fsSL \
		"https://archlinux.org/packages/search/json/?name=${PKGNAME}")" ||
		die "Falha ao consultar Arch Linux"

	PKGBASE="$(
		jq -r --arg pkg "$PKGNAME" '
            .results[]
            | select(.pkgname == $pkg)
            | .pkgbase
        ' <<<"$JSON" | head -n1
	)"

	if [[ -n "$PKGBASE" && "$PKGBASE" != "null" ]]; then
		REPO_URL="https://gitlab.archlinux.org/archlinux/packaging/packages/${PKGBASE}.git"
		msg "Pacote encontrado nos repositórios oficiais do Arch"
	else
		REPO_URL="https://aur.archlinux.org/${PKGNAME}.git"
		msg "Pacote não encontrado no Arch. Tentando AUR"
		DESTDIR="aur-$PKGNAME"
	fi

	git ls-remote --exit-code "$REPO_URL" &>/dev/null ||
		die "Pacote '$PKGNAME' não encontrado"

	cmd_run git clone --depth=1 "$REPO_URL" "$DESTDIR" ||
		die "Erro ao clonar '$PKGNAME'"

	cmd_run pushd "$DESTDIR" >/dev/null || die

	find . -type f \( -name '*.toml' -o -name '.*.toml' \) -delete
	find . -name '.SRCINFO' -type f -delete
	rm -rf .git

	{
		echo "#!/usr/bin/env bash"
		echo "# NOTE: Imported from Arch Linux/AUR"
		echo "# Maintainer: $PACKAGER"
		cat PKGBUILD
		echo
		sh_pre_post_install
	} >PKGFILE

	translate_pkgfile_deps arch PKGFILE

	{
		echo "pkg/"
		echo "src/"
	} >.gitignore

	#chmod +x PKGFILE
	#rm -f PKGBUILD

	shfmt -w PKGFILE
	cmd_run popd >/dev/null || true
	msg "${DESTDIR}/PKGFILE criado com sucesso."
	msg "Entre no diretório: ${yellow}cd $DESTDIR${rst}"
}

# -------------------------------------------------------------------
# new --from-void <pkgname>
# Importa template oficial do Void Linux (void-packages)
# -------------------------------------------------------------------
from_void() {
	local pkg="$1"
	local DIRPKGFILE="$2"
	local VOID_REPO="https://raw.githubusercontent.com/void-linux/void-packages/master"
	local TMP
	TMP="$(mktemp -d)"
	trap 'rm -rf -- "$TMP"' EXIT

	[[ -z "$pkg" ]] && die "nome do pacote não informado"

	msg "Importando template do Void Linux: $pkg"
	msg "Fonte: void-linux/void-packages"

	# Escolhe downloader
	if command -v curl >/dev/null 2>&1; then
		DL="curl -fsSL"
	elif command -v wget >/dev/null 2>&1; then
		DL="wget -qO-"
	else
		die "necessário 'curl' ou 'wget' para download"
	fi

	# Baixa template oficial (obrigatório)
	if ! $DL "$VOID_REPO/srcpkgs/$pkg/template" >"$TMP/template" 2>/dev/null; then
		[[ -n "$TMP" && "$TMP" != "/" ]] || die "TMP inválido"
		rm -rf -- "$TMP"
		die "template do Void não encontrado para pacote '$pkg'"
	fi

	# Tenta baixar INSTALL (opcional)
	if $DL "$VOID_REPO/srcpkgs/$pkg/INSTALL" >"$TMP/INSTALL" 2>/dev/null; then
		HAS_INSTALL=1
	else
		HAS_INSTALL=0
	fi

	# Cria diretório do pacote
	mkdir -p "${DIRPKGFILE}"
	cd "${DIRPKGFILE}" || die "não foi possível entrar no diretório '${DIRPKGFILE}'"

	# Gera PKGFILE com aviso explícito
	{
		echo "#!/usr/bin/env bash"
		echo "# NOTE: Imported from Void Linux official template"
		echo "# NOTE: Source: https://github.com/void-linux/void-packages"
		echo "# NOTE: This PKGFILE MUST be reviewed and adjusted before use"
		echo
		cat "$TMP/template"
	} >PKGFILE

	chmod +x PKGFILE

	# Copia INSTALL se existir
	if ((HAS_INSTALL)); then
		cp "$TMP/INSTALL" INSTALL
		chmod +x INSTALL
		msg "INSTALL importado."
	fi

	cd - >/dev/null || true
	[[ -n "$TMP" && "$TMP" != "/" ]] || die "TMP inválido"
	rm -rf -- "$TMP"

	msg "PKGFILE criado com sucesso."
	((HAS_INSTALL)) && msg "INSTALL criado com sucesso."
	msg "Entre no diretório com: cd ${DIRPKGFILE}"
	msg "Revisão manual obrigatória."
	exit 0
}

parse_config() {
	# Load global config
	set +o pipefail
	[[ -f /etc/pkgmake.conf ]] && source /etc/pkgmake.conf
	ret=$?
	set -o pipefail
	((ret == 0)) || die "erro ao carregar /etc/pkgmake.conf"
}

validate_config() {
	# SIGNPKG
	[[ "$SIGNPKG" =~ ^[01]$ ]] || die "SIGNPKG inválido (use 0 ou 1)"

	# VERBOSE
	[[ "$VERBOSE" =~ ^[01]$ ]] || die "VERBOSE inválido (use 0 ou 1)"

	# PACKAGER (se definido)
	if [[ -n "$PACKAGER" ]]; then
		[[ "$PACKAGER" == *"<"*">"* ]] || die "PACKAGER inválido (esperado: Nome <email>)"
	fi

	# Assinatura
	if [[ "$SIGNPKG" -eq 1 ]]; then
		ensure_privkey
	fi

	# ---------------------------------------------
	# Contrato de build / install
	# ---------------------------------------------

	if [[ "${build_style:-}" == "venom" ]]; then
		# venom exige build()
		((HAS_BUILD)) || die "função build() ausente (build_style=venom)"

	else
		# não-venom
		if [[ -n "${build_style:-}" ]]; then
			# build_style existe → pode não ter build nem package
			: # válido
		else
			# sem build_style → precisa de build OU package
			if ((!HAS_BUILD && !HAS_PACKAGE)); then
				die "nenhuma função build(), package() ou do_install() definida"
			fi
		fi
	fi

}

validate_pkgdest_sanity() {
	case "$PKGDEST" in
	*::* | *"//"*)
		die "PKGDEST inválido: $PKGDEST"
		;;
	esac
}

validate_packager_sanity() {
	msg "PACKAGER=$PACKAGER"
	[[ -z "$PACKAGER" ]] && die "PACKAGER inválido: $PACKAGER (esperado: Nome Sobrenome <email@dominio>)"
	regex='^[^<>]+ <[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}>$'
	if [[ ! "$PACKAGER" =~ $regex ]]; then
		die "PACKAGER inválido: $PACKAGER"
	fi
}

cmd_run() {
	if [[ "$VERBOSE" -eq 0 ]]; then
		"$@" >/dev/null
	else
		"$@"
	fi
	local rc=$?
	[[ $rc -eq 0 ]] || die "comando falhou: \n$*"
}

readconf() {
	local msg="$1"
	local color="${2:-${red}}"

	echo -n -e "$color"
	read -r -p "$msg [S/n]"
	echo -n -e "$reset"
	case "${REPLY^}" in
	[SY]) return 0 ;;
	"") return 0 ;;
	*) return 1 ;;
	esac
}

die() {
	echo -e "${red}ERRO: $*${reset}" >&2
	exit 1
}

msg() { echo -e "${cyan}==> $*${reset}"; }
warn() { echo -e "${yellow}==> aviso: $*${reset}" >&2; }
msg_error() {
	printf "${red}ERROR: %s${reset}\n" "$*" >&2
	exit 1
}

print_config() {
	cat <<EOF
# /etc/pkgmake.conf	
# pkgmake effective configuration

PKGDEST=${cyan}${PKGDEST:-"(default: ./repo)"}${rst}
PACKAGER=${cyan}${PACKAGER:-"(not set)"}${rst}

SYNCDEPS=${red}${SYNCDEPS:-0}${rst}
CLEANUP=${red}${CLEANUP:-0}${rst}

SIGNPKG=${red}${SIGNPKG:-0}${rst}
PRIVKEY=${cyan}${PRIVKEY:-"(auto-detect)"}${rst}

REINDEX_FORCE=${red}${REINDEX_FORCE:-1}${rst}

VERBOSE=${red}${VERBOSE:-0}${rst}
EOF
}

# gera a chave no caminho do PRIVKEY (--privkey ou /etc/pkgmake.conf);
# sem PRIVKEY definido, usa ~/.ssh/privkey.pem
gen_key() {
	local key="${PRIVKEY:-$HOME/.ssh/$KEY_FILE}"

	if [[ -f "$key" ]]; then
		if ! readconf "Chave '$key' já existe! Sobrescrever?"; then
			die "chave já existe: $key"
		fi
		rm -f "$key" "$key.pub"
	fi
	mkdir -p "$(dirname "$key")" || die "não consegui criar o diretório da chave: $(dirname "$key")"
	msg "Gerando chave RSA 4096 bits (PEM): $key"
	cmd_run ssh-keygen -t rsa -b 4096 -m PEM -f "$key"
	chmod 600 "$key"
	PRIVKEY="$key"
	msg "Chave gerada com sucesso: $key"
	warn "chave nova = assinatura nova: as máquinas que já usam o seu repositório precisam aceitar a nova chave pública"
}

# garante que a chave de assinatura existe; se não existir, oferece criar
# (só em terminal interativo; em CI/scripts para com erro)
ensure_privkey() {
	[[ -n "$PRIVKEY" ]] || find_privkey || PRIVKEY="$HOME/.ssh/$KEY_FILE"
	[[ -f "$PRIVKEY" ]] && return 0

	if [[ -t 0 && -t 1 ]]; then
		warn "chave privada não encontrada: $PRIVKEY"
		warn "uma chave nova gera assinatura nova: as máquinas que já usam o seu repositório vão precisar aceitar a nova chave pública"
		readconf "Criar a chave '$PRIVKEY' agora?" || die "assinatura cancelada: chave não encontrada: $PRIVKEY"
		gen_key
	else
		die "chave privada não encontrada: $PRIVKEY (crie com: pkgmake --gen-key)"
	fi
}

# get_repo_pkgver <nome-do-pacote> <repositorio-oficial>
get_repo_pkgver() {
  xbps-query -R -p pkgver "$1" 2>/dev/null
}

normalize_dep_patterns() {
	local var
	local i
	local dep

	for var in depends makedepends provides replaces conflicts; do
		declare -p "$var" &>/dev/null || continue
		declare -n arr="$var"

		arr=("${arr[@]}")

		for i in "${!arr[@]}"; do
			dep="${arr[$i]}"

			[[ -n "$dep" ]] || continue
			[[ "$dep" == "()" ]] && continue

			case "$var" in
			depends | replaces | conflicts)
				# se não tem operador, força >=0
				if ! [[ "$dep" =~ [\<\>\=] ]]; then
					arr[$i]="${dep}>=0"
				fi
				;;
			provides)
        # provides usa nome-versao (hifen+digito), nao operador
        if ! [[ "$dep" =~ -[0-9] ]]; then
				  ver_pkg=$(get_repo_pkgver "$dep")
          arr[$i]="${ver_pkg}"
				fi
				;;
			makedepends)
				# makedepends: não inventa constraint
				arr[$i]="$dep"
				;;
			esac
		done

		arr=("${arr[@]/()/}")
		arr=("${arr[@]}")
	done

	#debug
	#   echo "depends     ${depends[*]}"
	#   echo "makedepends ${makedepends[*]}"
	#   exit 0
}

normalize_deps() {
	local v
	for v in depends makedepends provides replaces conflicts; do
		if declare -p "$v" &>/dev/null; then
			# se não for array, converte string → array
			if [[ "$(declare -p "$v")" != declare\ -a* ]]; then
				local tmp
				tmp="${!v//$'\n'/ }"
				read -r -a "$v" <<<"$tmp"
			fi
		else
			# garante que exista como array
			declare -a "$v=()"
		fi
	done
}

load_pkgfile() {
  local cpath
  local curdir
  local dir

	# limpa possíveis funções herdadas do framework
	unset -f package build prepare pkgver check install pre_remove post_remove pre_update post_update pre_install post_install 2>/dev/null || true

  if [[ ! -f PKGFILE ]]; then
    dir=$PWD

      while [[ "$dir" != "/" ]]; do
          if [[ -f "$dir/pkgfile/PKGFILE" ]]; then
              cpath="$dir/pkgfile"
              break
          fi
          dir=$(dirname "$dir")
      done
  fi


	if [[ ! -f "PKGFILE" ]];  then
	  msg "PKGFILE encontrado em $cpath"
	  die "PKGFILE não encontrado aqui\n      ${rst}PKGFILE foi encontrado em ${yellow}$cpath\n      ${cyan}Use $APP --help"
  fi

	# carrega PKGFILE no shell principal
	source "PKGFILE"

	# extrai SOMENTE as funções definidas no PKGFILE (shell isolado)
	PKG_FUNCS="$(
		bash -c "
      source \"PKGFILE\"
      declare -F | awk '{print \$3}'
    "
	)"

	# Normalizar - Garantem que as variáveis existam
	: "${distfiles:=}"
	: "${source:=}"
}

pkg_has_fn() {
	grep -qx "$1" <<<"$PKG_FUNCS"
}

lint() {
	msg "Lint"

	# ---------------------------------------------
	# Contrato de build / install (por capacidade)
	# ---------------------------------------------

	# build_style=venom exige build real
	if [[ "${build_style:-}" == "venom" ]]; then
		((HAS_BUILD)) || die "função de build ausente (build_style=venom)"
	else
		# modo normal:
		# precisa ter alguma etapa válida: build, install ou build_style
		if ! ((HAS_BUILD || HAS_PACKAGE || HAS_BUILD_STYLE)); then
			die "nenhuma etapa de build ou install definida"
		fi
	fi

	# ---------------------------------------------
	# Install obrigatório (quando não há build_style)
	# ---------------------------------------------
	if ! ((HAS_PACKAGE)) && [[ -z "${build_style:-}" ]]; then
		die "nenhuma função de install definida (package() ou do_install())"
	fi

	# ---------------------------------------------
	# Proteção: não apagar source tree
	# ---------------------------------------------
	if grep -Eq \
		'rm[[:space:]]+-rf[[:space:]]+(\$|\$\{)(_pkgsrc|srcdir|pkgbase)|rm[[:space:]]+-rf[[:space:]]+["'"'"']?\$\{?pkgbase\}?-\$\{?pkgver\}?' \
		"PKGFILE"; then
		die "PKGFILE inválido: não use 'rm -rf' no diretório de source (incompatível com pkgmake)"
	fi
}

strip_dep_op() {
	local d="$1"
	d="${d%%>=*}"
	d="${d%%<=*}"
	d="${d%%=*}"
	echo "$d"
}

# -------------------------------------------------------------------
# Tradução de dependências (Arch/Venom -> Void)
# tabela: usr/share/pkgmake/pkgnames.map
# -------------------------------------------------------------------
declare -gA PKGMAP=()       # nome-origem -> nome-void ("-" = remover)
declare -gA PKGMAP_MAKE=()  # nome-void -> 1 (ferramenta só de build)
declare -gA PKGMAP_DEVEL=() # nome-void -> pacote -devel fora do padrão
declare -gA REPO_HAS_CACHE=()
PKGMAP_LOADED=0

pkgmap_file() {
	local bindir d
	bindir="$(dirname "$(readlink -f "$0")")"
	for d in "$bindir/../share/pkgmake" /usr/local/share/pkgmake /usr/share/pkgmake; do
		if [[ -f "$d/pkgnames.map" ]]; then
			echo "$d/pkgnames.map"
			return 0
		fi
	done
	return 1
}

load_pkgmap() {
	local file orig void rest t
	((PKGMAP_LOADED)) && return 0
	file="$(pkgmap_file)" || return 1
	while read -r orig void rest; do
		[[ -z "$orig" || "$orig" == \#* || -z "$void" ]] && continue
		PKGMAP["$orig"]="$void"
		for t in $rest; do
			case "$t" in
			make) PKGMAP_MAKE["$void"]=1 ;;
			devel=*) PKGMAP_DEVEL["$void"]="${t#devel=}" ;;
			esac
		done
	done <"$file"
	PKGMAP_LOADED=1
}

# pacote existe nos repositórios do Void (configurados + PKGDEST local)?
repo_has() {
	local n="$1" r=1
	local opts=(-R)
	if [[ -n "${REPO_HAS_CACHE[$n]+x}" ]]; then
		return "${REPO_HAS_CACHE[$n]}"
	fi
	[[ -n "${PKGDEST:-}" && -d "$PKGDEST" ]] && opts+=(--repository="$PKGDEST")
	xbps-query "${opts[@]}" "$n" >/dev/null 2>&1 && r=0
	REPO_HAS_CACHE["$n"]=$r
	return $r
}

# translate_name <origem> <nome>  -> nome no Void (vazio = remover)
translate_name() {
	local origin="$1" name="$2"
	if [[ -n "${PKGMAP[$name]+x}" ]]; then
		[[ "${PKGMAP[$name]}" == "-" ]] || echo "${PKGMAP[$name]}"
		return 0
	fi
	case "$name" in
	lib32-* | dh-* | debhelper*) return 0 ;;
	python-*)
		if [[ "$origin" == arch ]]; then
			echo "python3-${name#python-}"
			return 0
		fi
		;;
	py3-*)
		echo "python3-${name#py3-}"
		return 0
		;;
	esac
	echo "$name"
}

# pacote do Void que fornece um arquivo (usa o xlocate, se existir)
# file_owner <padrão> -> nome do pacote (vazio se não achar)
file_owner() {
	local line pkgver
	command -v xlocate >/dev/null 2>&1 || return 0
	line="$(xlocate "$1" 2>/dev/null | head -n1)"
	[[ -n "$line" ]] || return 0
	pkgver="${line%%[[:space:]]*}"
	echo "${pkgver%-*}"
}

# Debian: libfoo2-dev, libfoo-dev... tenta achar o nome do Void
debian_guess() {
	local n="$1" c
	for c in "$n" "${n#lib}" "${n%%[0-9.]*}" "$(echo "${n#lib}" | sed -E 's/[0-9.]+$//')" "$(echo "$n" | sed -E 's/-?[0-9.]+$//')"; do
		[[ -n "$c" ]] || continue
		if repo_has "$c" || repo_has "$c-devel"; then
			echo "$c"
			return 0
		fi
	done
	echo "$n"
}

# map_dep <origem> <token>
# resultado em MAP_NAME (nome no Void, vazio = remover), MAP_OP (versão)
# e MAP_ISDEV=1 quando a origem pede os headers (-dev/-devel/pkgconfig())
map_dep() {
	local origin="$1" tok="$2" name inner owner
	MAP_NAME="" MAP_OP="" MAP_ISDEV=0
	name="${tok%%[<>=]*}"
	MAP_OP="${tok#"$name"}"

	# dependências virtuais (Fedora/Alpine)
	case "$name" in
	pkgconfig\(*\) | pc:*)
		inner="${name#pkgconfig(}"
		inner="${inner%)}"
		inner="${inner#pc:}"
		owner="$(file_owner "/usr/*/pkgconfig/${inner}.pc")"
		MAP_ISDEV=1
		if [[ -n "$owner" ]]; then
			MAP_NAME="$owner"
		elif repo_has "${inner}-devel"; then
			MAP_NAME="${inner}"
		else
			MAP_NAME="?pkgconfig:${inner}"
		fi
		return 0
		;;
	cmake\(*\))
		inner="${name#cmake(}"
		inner="${inner%)}"
		owner="$(file_owner "/usr/*/cmake/*/${inner}Config.cmake")"
		[[ -n "$owner" ]] || owner="$(file_owner "/usr/*/cmake/*/${inner,,}-config.cmake")"
		MAP_ISDEV=1
		MAP_NAME="${owner:-?cmake:${inner}}"
		return 0
		;;
	perl\(*\))
		inner="${name#perl(}"
		inner="${inner%)}"
		MAP_NAME="perl-${inner//::/-}"
		return 0
		;;
	python3dist\(*\) | python3.*dist\(*\))
		inner="${name#*dist(}"
		inner="${inner%)}"
		MAP_NAME="python3-${inner}"
		return 0
		;;
	so:* | cmd:* | /*)
		inner="${name#so:}"
		inner="${inner#cmd:}"
		[[ "$name" == cmd:* ]] && inner="/usr/bin/$inner"
		[[ "$name" == so:* ]] && inner="/usr/lib/$inner"
		owner="$(file_owner "$inner")"
		MAP_NAME="${owner:-?file:${name}}"
		return 0
		;;
	esac

	case "$origin" in
	alpine | debian)
		if [[ "$name" == *-dev ]]; then
			MAP_ISDEV=1
			if [[ -n "${PKGMAP[$name]+x}" ]]; then
				MAP_NAME="$(translate_name "$origin" "$name")"
				return 0
			fi
			name="${name%-dev}"
		fi
		;;
	fedora)
		if [[ "$name" == *-devel ]]; then
			MAP_ISDEV=1
			if [[ -n "${PKGMAP[$name]+x}" ]]; then
				MAP_NAME="$(translate_name "$origin" "$name")"
				return 0
			fi
			name="${name%-devel}"
		fi
		;;
	esac

	MAP_NAME="$(translate_name "$origin" "$name")"
	if [[ "$origin" == debian && -n "$MAP_NAME" && "$MAP_NAME" == "$name" ]] &&
		command -v xbps-query >/dev/null 2>&1 && ! repo_has "$MAP_NAME"; then
		MAP_NAME="$(debian_guess "$MAP_NAME")"
	fi
}

# pacote -devel do Void para <nome> (vazio se não houver)
devel_of() {
	local n="$1"
	if [[ -n "${PKGMAP_DEVEL[$n]+x}" ]]; then
		echo "${PKGMAP_DEVEL[$n]}"
	elif [[ "$n" == *-devel ]]; then
		echo "$n"
	elif repo_has "$n-devel"; then
		echo "$n-devel"
	fi
}

# linhas inicial e final do array <var>=( ... ) no nível do arquivo
dep_array_range() {
	awk -v v="$2" '
		!start && $0 ~ "^" v "=\\(" { start = NR }
		start {
			line = $0
			sub(/#.*/, "", line)
			if (index(line, ")")) { print start, NR; exit }
		}
	' "$1"
}

# itens do array <var> (um por linha, sem aspas e comentários)
dep_array_items() {
	local r s e
	r="$(dep_array_range "$1" "$2")"
	[[ -n "$r" ]] || return 0
	read -r s e <<<"$r"
	sed -n "${s},${e}p" "$1" |
		sed -E 's/#.*$//' |
		sed -E "1s/^$2=\\(//" |
		sed -E '$s/\).*$//' |
		tr -d "\"'" |
		tr -s ' \t' '\n\n' |
		sed '/^$/d'
}

# dep_array_write <arquivo> <var> <nota> <itens...>
# substitui o array; se não existir, cria depois do depends (ou do pkgrel)
dep_array_write() {
	local f="$1" v="$2" note="$3"
	shift 3
	local r s e tmp after i
	tmp="$(mktemp)"
	{
		[[ -n "$note" ]] && echo "$note"
		if (($#)); then
			echo "${v}=("
			for i in "$@"; do
				if [[ "$i" == *'$'* ]]; then
					printf '\t"%s"\n' "$i"
				else
					printf "\t'%s'\n" "$i"
				fi
			done
			echo ")"
		else
			echo "${v}=()"
		fi
	} >"$tmp.block"

	r="$(dep_array_range "$f" "$v")"
	if [[ -n "$r" ]]; then
		read -r s e <<<"$r"
		{
			head -n $((s - 1)) "$f"
			cat "$tmp.block"
			tail -n +$((e + 1)) "$f"
		} >"$tmp"
	else
		r="$(dep_array_range "$f" depends)"
		if [[ -n "$r" ]]; then
			read -r s after <<<"$r"
		else
			after="$(grep -n -m1 '^pkgrel=' "$f" | cut -d: -f1)"
			[[ -n "$after" ]] || after="$(wc -l <"$f")"
		fi
		{
			head -n "$after" "$f"
			cat "$tmp.block"
			tail -n +$((after + 1)) "$f"
		} >"$tmp"
	fi
	cat "$tmp" >"$f"
	rm -f "$tmp" "$tmp.block"
}

# acrescenta <valor> no array <nome> se ainda não estiver lá
add_unique() {
	local -n _arr="$1"
	local x
	for x in "${_arr[@]}"; do
		[[ "$x" == "$2" ]] && return 0
	done
	_arr+=("$2")
}

# translate_deps_core <origem>
# entrada: IN_DEPS / IN_MDEPS   saída: OUT_DEPS / OUT_MDEPS / OUT_MISSING
translate_deps_core() {
	local origin="$1" has_xbps=0 tok new dv n
	OUT_DEPS=() OUT_MDEPS=() OUT_MISSING=()
	command -v xbps-query >/dev/null 2>&1 && has_xbps=1

	for tok in "${IN_DEPS[@]}"; do
		# variáveis/expressões: mantém como está
		if [[ "$tok" == *'$'* ]]; then
			add_unique OUT_DEPS "$tok"
			continue
		fi
		map_dep "$origin" "$tok"
		new="$MAP_NAME"
		[[ -n "$new" ]] || continue
		if [[ "$new" == \?* ]]; then
			add_unique OUT_MISSING "${new#\?}"
			continue
		fi
		# pediu headers no depends: vai para o makedepends
		if ((MAP_ISDEV)); then
			dv="$(devel_of "$new")"
			# sem -devel no Void: headers/dados ficam no próprio pacote
			[[ -z "$dv" ]] && { ((has_xbps)) && dv="$new" || dv="$new-devel"; }
			add_unique OUT_MDEPS "$dv$MAP_OP"
			continue
		fi
		# Venom/Debian não separam bem build/runtime: ferramenta de build vai para o makedepends
		if [[ "$origin" == venom && -n "${PKGMAP_MAKE[$new]+x}" ]]; then
			add_unique OUT_MDEPS "$new$MAP_OP"
			continue
		fi
		add_unique OUT_DEPS "$new$MAP_OP"
		# Arch/Venom: biblioteca no depends também precisa do -devel para o build
		if ((has_xbps)) && [[ "$origin" == arch || "$origin" == venom ]] && [[ -z "${PKGMAP_MAKE[$new]+x}" ]]; then
			dv="$(devel_of "$new")"
			[[ -n "$dv" ]] && add_unique OUT_MDEPS "$dv$MAP_OP"
		fi
	done

	for tok in "${IN_MDEPS[@]}"; do
		if [[ "$tok" == *'$'* ]]; then
			add_unique OUT_MDEPS "$tok"
			continue
		fi
		map_dep "$origin" "$tok"
		new="$MAP_NAME"
		[[ -n "$new" ]] || continue
		if [[ "$new" == \?* ]]; then
			add_unique OUT_MISSING "${new#\?}"
			continue
		fi
		if ((MAP_ISDEV)); then
			dv="$(devel_of "$new")"
			[[ -z "$dv" ]] && { ((has_xbps)) && dv="$new" || dv="$new-devel"; }
			new="$dv"
		elif ((has_xbps)) && [[ "$origin" == arch || "$origin" == venom ]] && [[ -z "${PKGMAP_MAKE[$new]+x}" ]]; then
			# Arch/Venom: os headers vêm no pacote principal; no Void ficam no -devel
			dv="$(devel_of "$new")"
			[[ -n "$dv" ]] && new="$dv"
		fi
		add_unique OUT_MDEPS "$new$MAP_OP"
	done

	if ((has_xbps)); then
		for tok in "${OUT_DEPS[@]}" "${OUT_MDEPS[@]}"; do
			[[ "$tok" == *'$'* ]] && continue
			n="$(strip_dep_op "$tok")"
			repo_has "$n" || add_unique OUT_MISSING "$n"
		done
	fi
}

# translate_pkgfile_deps <origem> <PKGFILE>
# traduz depends/makedepends de um PKGFILE já escrito (feito só na importação)
translate_pkgfile_deps() {
	local origin="$1" f="$2" note
	local odeps=() omdeps=()

	if ! load_pkgmap; then
		warn "pkgnames.map não encontrado: depends/makedepends NÃO foram traduzidos"
		return 0
	fi
	command -v xbps-query >/dev/null 2>&1 ||
		warn "xbps-query não encontrado: sem -devel automático e sem conferência no repositório do Void"

	mapfile -t odeps < <(dep_array_items "$f" depends)
	mapfile -t omdeps < <(dep_array_items "$f" makedepends)
	((${#odeps[@]} + ${#omdeps[@]})) || return 0

	msg "Traduzindo depends/makedepends ($origin -> Void)"
	IN_DEPS=("${odeps[@]}")
	IN_MDEPS=("${omdeps[@]}")
	translate_deps_core "$origin"

	if [[ "${OUT_DEPS[*]}" != "${odeps[*]}" ]]; then
		note=""
		((${#odeps[@]})) && note="# NOTE: depends original ($origin): ${odeps[*]}"
		dep_array_write "$f" depends "$note" "${OUT_DEPS[@]}"
	fi
	if [[ "${OUT_MDEPS[*]}" != "${omdeps[*]}" ]]; then
		note=""
		((${#omdeps[@]})) && note="# NOTE: makedepends original ($origin): ${omdeps[*]}"
		dep_array_write "$f" makedepends "$note" "${OUT_MDEPS[@]}"
	fi
	report_missing_deps
}

report_missing_deps() {
	((${#OUT_MISSING[@]})) || return 0
	warn "não encontrados nos repositórios do Void (corrija no PKGFILE ou acrescente no pkgnames.map): ${OUT_MISSING[*]}"
}

# escreve depends/makedepends traduzidos num PKGFILE gerado do zero
# write_translated_deps <origem> <PKGFILE>   (usa IN_DEPS/IN_MDEPS)
write_translated_deps() {
	local origin="$1" f="$2" note
	if ! load_pkgmap; then
		warn "pkgnames.map não encontrado: depends/makedepends NÃO foram traduzidos"
		OUT_DEPS=("${IN_DEPS[@]}") OUT_MDEPS=("${IN_MDEPS[@]}") OUT_MISSING=()
	else
		command -v xbps-query >/dev/null 2>&1 ||
			warn "xbps-query não encontrado: sem -devel automático e sem conferência no repositório do Void"
		msg "Traduzindo depends/makedepends ($origin -> Void)"
		translate_deps_core "$origin"
	fi
	note=""
	((${#IN_DEPS[@]})) && note="# NOTE: depends original ($origin): ${IN_DEPS[*]}"
	dep_array_write "$f" depends "$note" "${OUT_DEPS[@]}"
	note=""
	((${#IN_MDEPS[@]})) && note="# NOTE: makedepends original ($origin): ${IN_MDEPS[*]}"
	dep_array_write "$f" makedepends "$note" "${OUT_MDEPS[@]}"
	report_missing_deps
}

# conferência no build: só avisa, não altera nada
check_deps_repo() {
	local v d n
	command -v xbps-query >/dev/null 2>&1 || return 0
	load_pkgmap || true
	for v in depends makedepends; do
		local -n _deps="$v"
		for d in "${_deps[@]}"; do
			[[ -z "$d" || "$d" == *'$'* ]] && continue
			n="$(strip_dep_op "$d")"
			repo_has "$n" && continue
			xbps-query "$n" >/dev/null 2>&1 && continue
			if [[ -n "${PKGMAP[$n]+x}" && "${PKGMAP[$n]}" != "-" ]]; then
				warn "$v: '$n' não existe no Void; equivalente provável: ${PKGMAP[$n]}"
			elif [[ "${PKGMAP[$n]:-}" == "-" ]]; then
				warn "$v: '$n' não é usado no Void; remova do PKGFILE"
			else
				warn "$v: '$n' não encontrado nos repositórios do Void"
			fi
		done
		unset -n _deps
	done
}

sync_deps() {
	[[ "$SYNCDEPS" -eq 1 ]] || return 0

	local pkgs=()
	[[ -n "${makedepends[*]}" ]] && pkgs+=("${makedepends[@]}")
	#  [[ -n "${depends[*]}" ]] && pkgs+=("${depends[@]}")
	[[ "${#pkgs[@]}" -eq 0 ]] && return 0

	local clean=()
	for d in "${pkgs[@]}"; do
		# se tem comparador, NÃO TOCA
		if [[ "$d" =~ [\<\>\=] ]]; then
			clean+=("$d")
		else
			# já instalado? pula (evita "ERROR: Package already installed")
			xbps-query "$d" &>/dev/null && continue
			clean+=("$(strip_dep_op "$d")")
		fi
	done

	if [[ "${#clean[@]}" -eq 0 ]]; then
		msg "makedepends já instalados"
		return 0
	fi

	cmd_run sudo xbps-install -Sy "${clean[@]}"
}

# fonte git no formato Arch: [nome::]git+URL ou [nome::]git://URL
# fragmentos: #tag=  #branch=  #commit=   (query ?signed é ignorada)
is_git_source() {
	local s="${1#*::}"
	[[ "$s" == git+* || "$s" == git://* ]]
}

fetch() {
	[[ -n "$SRCDIR" ]] || die "SRCDIR não definido"
	mkdir -p "$SRCDIR"
	cd "$SRCDIR" || die "falha ao entrar em $SRCDIR"

	if ((IS_LOCAL_SOURCE)); then
		msg "Pulando fetch (source local)"
		return 0
	fi

	msg "Fetch source"

	for src in "${source[@]}"; do
		# alias::source
		if [[ "$src" == *::* ]]; then
			cname="${src%%::*}"
			s="${src#*::}"
		else
			cname=""
			s="$src"
		fi

		case "$s" in
		git+* | git://*)
			repo="${s#git+}"
			ref_type=""
			ref=""

			if [[ "$repo" == *#* ]]; then
				frag="${repo#*#}"
				frag="${frag%%\?*}"
				repo="${repo%%#*}"
				ref_type="${frag%%=*}"
				ref="${frag#*=}"
				case "$ref_type" in
				tag | branch | commit) ;;
				*) die "fragmento git não suportado: #$frag (use tag=, branch= ou commit=)" ;;
				esac
			fi
			repo="${repo%%\?*}"

			[[ -z "$cname" ]] && cname="$(basename "$repo" .git)"

			if [[ -d "$cname/.git" ]]; then
				msg "Usando repositório git existente: $cname"
				cmd_run git -C "$cname" remote set-url origin "$repo"
				# cópia limpa a cada build (descarta patches e sobras do build anterior)
				cmd_run git -C "$cname" reset -q --hard
				cmd_run git -C "$cname" clean -qfdx

				case "$ref_type" in
				tag)
					cmd_run git -C "$cname" fetch --depth=1 origin "refs/tags/$ref:refs/tags/$ref"
					cmd_run git -C "$cname" checkout "$ref"
					;;
				branch)
					cmd_run git -C "$cname" fetch --depth=1 origin "$ref"
					cmd_run git -C "$cname" checkout -B "$ref" FETCH_HEAD
					;;
				commit)
					# commit já presente? senão busca histórico completo
					if ! git -C "$cname" cat-file -e "${ref}^{commit}" 2>/dev/null; then
						if [[ "$(git -C "$cname" rev-parse --is-shallow-repository)" == true ]]; then
							cmd_run git -C "$cname" fetch --unshallow origin
						else
							cmd_run git -C "$cname" fetch origin
						fi
					fi
					cmd_run git -C "$cname" checkout "$ref"
					;;
				*)
					cmd_run git -C "$cname" pull --ff-only
					;;
				esac
			else
				msg "Fetching: ${yellow}$s${rst}"

				case "$ref_type" in
				tag | branch)
					cmd_run git clone --recursive --branch "$ref" --depth=1 "$repo" "$cname"
					;;
				commit)
					# nem todo servidor permite buscar commit avulso: clone completo
					cmd_run git clone "$repo" "$cname"
					cmd_run git -C "$cname" checkout "$ref"
					;;
				*)
					cmd_run git clone --recursive --depth=1 "$repo" "$cname"
					;;
				esac
			fi

			# submódulos acompanham o ref escolhido
			if [[ -n "$ref_type" && -f "$cname/.gitmodules" ]]; then
				cmd_run git -C "$cname" submodule update --init --recursive
			fi
			;;

		http://* | https://*)
			# nome::url → salva com o nome dado (como no makepkg do Arch)
			f="${cname:-${s##*/}}"

			if [[ -f "$f" ]]; then
				msg "Source já existe, usando cache: $f"
			else
				msg "Fetching: ${yellow}$s${rst}"

				if ! curl -fL --output "./$f" -- "$s"; then
					case "$f" in
					*.asc | *.sig)
						warn "assinatura não encontrada ($f), ignorando"
						;;
					*)
						die "falha ao baixar source obrigatório: $f"
						;;
					esac
				fi
			fi
			;;

		*)
			[[ -f "$WORKDIR/$s" ]] || die "arquivo local não encontrado: $s"
			cp -f "$WORKDIR/$s" .
			;;
		esac
	done
}

extract() {
	cd "$SRCDIR" || die "falha ao entrar em $SRCDIR"

	if ((IS_LOCAL_SOURCE)); then
		msg "Pulando extract (source local)"
		return 0
	fi

	msg "Extract source"
	local extracted=0
	shopt -s nullglob

	for f in *.tar *.tar.gz *.tgz *.tar.xz *.tar.bz2 *.tar.zst *.deb *.zip; do
		case "$f" in
		*.tar.gz | *.tgz)
			cmd_run tar -xzf "$f" && extracted=1 || die "falha ao extrair $f"
			;;
		*.tar.xz)
			cmd_run tar -xJf "$f" && extracted=1 || die "falha ao extrair $f"
			;;
		*.tar.bz2)
			cmd_run tar -xjf "$f" && extracted=1 || die "falha ao extrair $f"
			;;
		*.tar.zst)
			cmd_run tar --zstd -xf "$f" && extracted=1 || die "falha ao extrair $f"
			;;
		*.tar)
			cmd_run tar -xf "$f" && extracted=1 || die "falha ao extrair $f"
			;;
		*.deb)
			cmd_run ar x "$f" &&
				cmd_run tar -xf data.tar.* &&
				extracted=1 || die "falha ao extrair $f"
			;;
		*.zip)
			cmd_run unzip -o "$f" && extracted=1 || die "falha ao extrair $f"
			;;
		esac
	done

	shopt -u nullglob

	if [[ "$HAS_GIT_SOURCE" -eq 1 ]]; then
		msg "Fonte VCS detectada, pulando extração de tarball"
		return 0
	fi

	# Tarball foi extraído
	if ((extracted)); then
		return 0
	fi

	# Fallback final: fonte local (SRCDIR já é o source)
	if ((IS_LOCAL_SOURCE)); then
		if [[ -z "$(ls -A . 2>/dev/null)" ]]; then
			die "source local declarado, mas SRCDIR está vazio"
		fi
		msg "Source local confirmado (conteúdo já presente em SRCDIR)"
		return 0
	fi

	die "nenhuma fonte encontrada (tarball, git ou src/)"
}

detect_src() {
	local dirs

	msg "Detectando src..."
	mapfile -t dirs < <(find "$SRCDIR" -mindepth 1 -maxdepth 1 -type d)

	# Compatibilidade:
	# SRCDIR   → diretório raiz do source
	# srcdir   → alias (Arch/Venom)
	# _pkgsrc  → alias (pkgmake/xbps)

	case "${#dirs[@]}" in
	0)
		export srcdir="$SRCDIR"
		export _pkgsrc="$SRCDIR"
		export wrksrc="$SRCDIR"
		;;
	1)
		export srcdir="$SRCDIR"
		export _pkgsrc="${dirs[0]}"
		export wrksrc="${dirs[0]}"
		;;
	*)
		#die "múltiplos diretórios de source encontrados após extração"
		export srcdir="$SRCDIR"
		export _pkgsrc="$SRCDIR"
		export wrksrc="$SRCDIR"
		;;
	esac
	export pkgdir="$PKGDIR"
	export DESTDIR="$PKGDIR"
}

find_privkey() {
	local aKeys=(
		"$HOME/.ssh/private.pem"
		"$HOME/.ssh/privkey.pem"
		"$HOME/.gnupg/private.pem"
		"$HOME/.gnupg/privkey.pem"
	)

	[[ -n "$PRIVKEY" ]] && return 0
	for k in "${aKeys[@]}"; do
		[[ -f "$k" ]] && {
			PRIVKEY="$k"
			msg "Chave encontrada em : $k"
			return 0
		}
	done
	return 1
}

sh_create_REMOVE() {
	local PKG="${pkgname}-${pkgver}_${pkgrel}"
	local cPath="$pkgdir"
	local cScript="$cPath/REMOVE"

	if ! $IS_REMOVE_CREATED; then
		mkdir -p "$cPath"

		{
			echo '#!/bin/bash'
			echo '# Generated by pkgmake'
			echo 'set -e'
			echo
      echo 'user="${SUDO_USER:-$USER}"'
      echo 'if [ "$user" = "root" ]; then'
      echo '  IFS=: read -r user _ <<EOF'
      echo '$(getent passwd 1000)'
      echo 'EOF'
      echo '[ -z $user ] && user=anon'
      echo 'fi'
      echo 'user_home=$(getent passwd "$user" | cut -d: -f6)'
      echo
			# ⚠️ aqui é o ponto-chave: a função é EXPANDIDA AGORA
			pkg_has_fn pre_remove && declare -f pre_remove | sed -E 's/^[[:space:]]*function[[:space:]]+//'
			echo
			pkg_has_fn post_remove && declare -f post_remove | sed -E 's/^[[:space:]]*function[[:space:]]+//'
			echo

			echo 'ACTION="$1"'
			echo 'action="$1"'
			echo 'PKGNAME="$2"'
			echo 'pkgname="$2"'
			echo 'VERSION="$3"'
			echo 'pkgver="$3"'
			echo 'UPDATE="$4"'
			echo 'update="$4"'
			echo

			echo 'case "$ACTION" in'
			echo 'pre)'
			if pkg_has_fn pre_remove; then
				echo '  pre_remove'
			else
				echo '  :'
			fi
			echo '  ;;'
			echo 'post)'
			if pkg_has_fn post_remove; then
				echo '  post_remove'
			else
				echo '  :'
			fi
			echo '  ;;'
			echo 'esac'
		} >"$cScript"

		chmod +x "$cScript"
		shfmt -ln sh -w "$cScript"
		IS_REMOVE_CREATED=true
		return 0
	fi
	return 1
}

sh_create_INSTALL() {
	local PKG="${pkgname}-${pkgver}_${pkgrel}"
	local cPath="$pkgdir"
	local cScript="$cPath/INSTALL"

	if ! $IS_INSTALL_CREATED; then
		mkdir -p "$cPath"

		{
			echo '#!/bin/bash'
			echo '# Generated by pkgmake'
			echo 'set -e'
			echo
      echo 'user="${SUDO_USER:-$USER}"'
      echo 'if [ "$user" = "root" ]; then'
      echo '  IFS=: read -r user _ <<EOF'
      echo '$(getent passwd 1000)'
      echo 'EOF'
      echo '[ -z $user ] && user=anon'
      echo 'fi'
      echo 'user_home=$(getent passwd "$user" | cut -d: -f6)'
			echo
			echo 'if [ -t 1 ]; then'
			echo '  RESET="$(printf "%b" "\033[0m")"'
			echo '  RST="$(printf "%b" "\033[0m")"'
			echo '  BLACK="$(printf "%b" "\033[1;30m")"'
			echo '  RED="$(printf "%b" "\033[1;31m")"'
			echo '  GREEN="$(printf "%b" "\033[1;32m")"'
			echo '  YELLOW="$(printf "%b" "\033[1;33m")"'
			echo '  BLUE="$(printf "%b" "\033[1;34m")"'
			echo '  MAGENTA="$(printf "%b" "\033[1;35m")"'
			echo '  CYAN="$(printf "%b" "\033[1;36m")"'
			echo '  WHITE="$(printf "%b" "\033[1;37m")"'
			echo 'fi'
			echo 'log() {'
			echo '  printf "%s[*]%s %s - %s\n" "$CYAN" "${BLACK}$pkgname" "${RST}" "${CYAN}$*${RESET}" 1>&2'
			echo '}'
			echo 'warn() {'
			echo '  printf "%s[*]WARNING:%s %s - %s\n" "$YELLOW" "$RESET" "$pkgname" "$*" 1>&2'
			echo '  exit 1'
			echo '}'
			echo 'die() {'
			echo '  printf "%s[*]FATAL:%s %s - %s\n" "$RED" "$RESET" "$pkgname" "$*" 1>&2'
			echo '  exit 1'
			echo '}'
			echo 'require_cmd() {'
			echo '  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"'
			echo '}'
			echo

			# ⚠️ aqui é o ponto-chave: a função é EXPANDIDA AGORA
			# expande apenas se existir
			pkg_has_fn pre_install && declare -f pre_install | sed -E 's/^[[:space:]]*function[[:space:]]+//'
			echo
			pkg_has_fn post_install && declare -f post_install | sed -E 's/^[[:space:]]*function[[:space:]]+//'
			echo
			pkg_has_fn pre_upgrade && declare -f pre_upgrade | sed -E 's/^[[:space:]]*function[[:space:]]+//'
			echo
			pkg_has_fn post_upgrade && declare -f post_upgrade | sed -E 's/^[[:space:]]*function[[:space:]]+//'
			echo
			echo 'ACTION="$1"'
			echo 'action="$1"'
			echo 'PKGNAME="$2"'
			echo 'pkgname="$2"'
			echo 'VERSION="$3"'
			echo 'pkgver="$3"'
			echo 'UPDATE="$4"'
			echo 'update="$4"'
			echo

			echo 'case "$ACTION" in'
			echo 'pre)'
			echo '  if [ "$UPDATE" = "yes" ]; then'
			if pkg_has_fn pre_upgrade; then
				echo '    pre_upgrade'
			else
				echo '    :'
			fi
			echo '  else'
			if pkg_has_fn pre_install; then
				echo '    pre_install'
			else
				echo '    :'
			fi
			echo '  fi'
			echo '  ;;'
			echo 'post)'
			echo '  if [ "$UPDATE" = "yes" ]; then'
			if pkg_has_fn post_upgrade; then
				echo '    post_upgrade'
			else
				echo '    :'
			fi
			echo '  else'
			if pkg_has_fn post_install; then
				echo '    post_install'
			else
				echo '    :'
			fi
			echo '  fi'
			echo '  ;;'
			echo 'esac'
		} >"$cScript"

		chmod +x "$cScript"
		shfmt -ln sh -w "$cScript"
		IS_INSTALL_CREATED=true
		return 0
	fi
	return 1
}

# pkgver() do PKGFILE (estilo Arch): roda após prepare(), dentro de $srcdir.
# A saída substitui o pkgver= do PKGFILE (o arquivo PKGFILE não é alterado).
run_pkgver_fn() {
	pkg_has_fn pkgver || return 0

	local newver
	msg "Executando pkgver()"
	newver="$(cd "$srcdir" && pkgver)" || die "pkgver() falhou"

	# regras Arch (: / - espaço) + xbps (_ e ao menos um dígito)
	if [[ -z "$newver" || "$newver" == *[[:space:]:/_-]* || ! "$newver" =~ [0-9] ]]; then
		die "pkgver() retornou versão inválida: '${newver}'\n      ${rst}(proibido: espaço : / - _ ; exige ao menos um dígito)"
	fi

	if [[ "$newver" != "$pkgver" ]]; then
		msg "pkgver: ${yellow}${pkgver:-(vazio)}${cyan} -> ${yellow}${newver}${rst}"
	fi
	pkgver="$newver"
}

run_all() {
	# -------------------------------------------------
	# Lint
	# -------------------------------------------------
	lint

	sync_deps

	# -------------------------------------------------
	# Fetch
	# -------------------------------------------------
	fetch

	# extrai ANTES de detectar o diretório da fonte (detect_src define $wrksrc
	# pelas pastas em src/, que só existem depois da extração)
	extract
	detect_src

	# -------------------------------------------------
	# Diretório de trabalho
	# -------------------------------------------------
	cd "$srcdir" || die "falha ao entrar em srcdir"

	# -------------------------------------------------
	# Ambiente Venom (spkgbuild)
	# -------------------------------------------------
	if [[ "${build_style:-}" == "venom" ]]; then
		export SRC="$WORKDIR"
		export PKG="$PKGDIR"
		mkdir -p "$PKG"
	fi

	# -------------------------------------------------
	# Prepare
	# -------------------------------------------------
	if ((HAS_PREPARE)); then
		msg "Prepare"
		cd "$srcdir" || die "falha ao entrar em srcdir"
		prepare
	fi

	# -------------------------------------------------
	# pkgver() (após prepare, como no makepkg do Arch)
	# -------------------------------------------------
	run_pkgver_fn
	PKGOUT="${pkgname}-${pkgver}_${pkgrel}.${ARCH}.xbps"

	# -------------------------------------------------
	# Build
	# -------------------------------------------------
	if ((HAS_BUILD)); then
		msg "Build"
		cd "$srcdir" || die "falha ao entrar em srcdir"
		if ! build; then
			die "Build falhou, abortando empacotamento"
		fi
	elif ((HAS_BUILD_STYLE)) && [[ "${build_style:-}" != "venom" ]]; then
		msg "Build style"
		do_build_style
	fi

	# -------------------------------------------------
	# DESTDIR (exceto venom)
	# -------------------------------------------------
	if [[ "${build_style:-}" != "venom" ]]; then
		[[ -n "${DESTDIR:-}" ]] || die "DESTDIR não definido"
		mkdir -p "$DESTDIR"
		[[ "$DESTDIR" != "/" ]] || die "DESTDIR inválido"
	fi

	# -------------------------------------------------
	# Pre/Post install
	# Pre/Post upgrade
	# Pre/Post upgrade
	# -------------------------------------------------
	if ! $IS_INSTALL_CREATED; then
		sh_create_INSTALL
	fi

	if ! $IS_REMOVE_CREATED; then
		sh_create_REMOVE
	fi

	# -------------------------------------------------
	# Package / Install
	# -------------------------------------------------
	if [[ "${build_style:-}" == "venom" ]]; then
		msg "Package step skipped (build_style=venom)"
	elif ((HAS_PACKAGE)); then
		msg "Package ${pkgname}"
		cd "$srcdir" || die "falha ao entrar em srcdir"
		if ! package; then
			die "Package falhou, abortando empacotamento"
		fi
	elif ((HAS_BUILD_STYLE)); then
		msg "Package (fakeroot)"
		command -v fakeroot >/dev/null 2>&1 || die "fakeroot não encontrado"
		fakeroot make install DESTDIR="$DESTDIR" docdir=/usr/share/doc
	else
		die "nenhuma etapa de install encontrada"
	fi

	# -------------------------------------------------
	# Grava arquivos para backup
	# -------------------------------------------------
	resolve_conffiles

	deps_list="${depends[*]}"
	provides_list="${provides[*]}"
	replaces_list="${replaces[*]}"
	conflicts_list="${conflicts[*]}"
	license_list="${license[*]}"

	INSTALL_OPTS=()
	[[ -f "$WORKDIR/INSTALL" ]] && INSTALL_OPTS+=(-S "$WORKDIR/INSTALL")

	msg "Create XBPS $PKGOUT"
	cmd_run xbps-create \
		--architecture "$ARCH" \
		--pkgver "${pkgname}-${pkgver}_${pkgrel}" \
		--desc "$pkgdesc" \
		--maintainer "$PACKAGER" \
		--license "$license_list" \
		--dependencies "$deps_list" \
		--provides "$provides_list" \
		--replaces "$replaces_list" \
		--conflicts "$conflicts_list" \
		--config-files "$conf_files_arg" \
		"$pkgdir"

	# mover pacote para o repo local
	mv -f "$PKGOUT" "$PKGDEST/"

	# -------------------------------------------------
	# Sign package (mantido como você pediu)
	# -------------------------------------------------
	if ((SIGNPKG)); then
		sign_only "${PKGOUT}"
	fi

	# -------------------------------------------------
	# Reindex repo
	# -------------------------------------------------
	create_repodata

	# -------------------------------------------------
	# Install opcional
	# -------------------------------------------------
	if ((INSTALLPKG)); then
		msg "Install package"
		if ((FORCEPKG)); then
			sudo xbps-install -R "$PKGDEST" -S -f "$pkgname"
		else
			sudo xbps-install -R "$PKGDEST" -S "$pkgname"
		fi
	else
		local built_pkgver="${pkgname}-${pkgver}_${pkgrel}"
		local inst_pkgver
		inst_pkgver="$(xbps-query -p pkgver "$pkgname" 2>/dev/null)"

		if [[ "$inst_pkgver" == "$built_pkgver" ]]; then
			# mesma versão instalada: xbps-install acusaria "already installed"
			msg "${yellow}$built_pkgver${cyan} já está instalado (mesma versão)"
			msg "Reinstall with: ${yellow}sudo /usr/bin/xbps-install -R ${PKGMAKE_HOST_PKGDEST:-$PKGDEST} -S -f $pkgname${rst}"
		else
			cmd_run sudo xbps-install --dry-run -R "$PKGDEST" -S "$pkgname"
			msg "Install with #1: ${yellow}sudo /usr/bin/xbps-install -R ${PKGMAKE_HOST_PKGDEST:-$PKGDEST} $pkgname${rst}"
			msg "Install with #2: ${yellow}vinstall -R ${PKGMAKE_HOST_PKGDEST:-$PKGDEST} $pkgname${rst}"
		fi
	fi
}

# dispatcher mínimo para build_style
do_build_style() {
	case "$build_style" in
	gnu-configure)
		do_build_gnu_configure
		;;
	venom)
		do_build_venom
		;;
	*)
		die "build_style não suportado: $build_style"
		;;
	esac
}

################################################################################################################
# HELPERS PARA VOID
################################################################################################################
vcopy() {
	local src="$1"
	local dest="$2"
	local s

	# comportamento xbps-src: se faltar argumento, ignora
	[[ -n "$src" && -n "$dest" ]] || return 0

	s="$wrksrc/$src"

	# se não existir, não faz nada
	[[ -e "$s" ]] || return 0

	if [[ -d "$s" ]]; then
		mkdir -p "$DESTDIR/$dest"
		cp -a "$s"/. "$DESTDIR/$dest"/
	else
		install -Dm644 "$s" "$DESTDIR/$dest"
	fi
}

vsconf() {
	local f="$1"

	[[ -f "$f" ]] || die "vsconf: arquivo '$f' não encontrado"
	install -Dm644 "$f" "$DESTDIR/etc/$(basename "$f")"

	# registra como conffile
	conf_files+=" /etc/$(basename "$f")"
}

vlicense() {
	local f

	for f in "$@"; do
		if [ ! -f "$f" ]; then
			msg_error "$pkgname: license file '$f' does not exist\n"
		fi

		install -Dm644 "$f" \
			"$DESTDIR/usr/share/licenses/$pkgname/$(basename "$f")"
	done
}

################################################################################################################

do_install_style() {
	case "$build_style" in
	gnu-configure)
		do_install_gnu_configure
		;;
	*)
		die "build_style não suportado: $build_style"
		;;
	esac
}

do_build_gnu_configure() {
	: "${configure_args:=}"
	: "${make_cmd_args:=}"

	cd "$wrksrc" || die "não foi possível entrar em Swrksrc"

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libdir=/usr/lib \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		$configure_args

	make $make_cmd_args
}

do_install_gnu_configure() {
	cd "$wrksrc" || die "não foi possível entrar em Swrksrc"
	make DESTDIR="$PKGDEST" install
}

do_build_venom() {
	msg "Build style: venom (monolithic build)"

	pkg_has_fn build || die "função build() ausente (build_style=venom)"
	build

	if pkg_has_fn package; then
		msg "Package"
		package
	else
		msg "Package step skipped (build_style=venom)"
	fi
}

clean() {
	[[ -n "$SRCDIR" && -n "$PKGDIR" && -n "$PKGDEST" ]] || die "variáveis de clean inválidas"
	rm -rf -- "$SRCDIR" "$PKGDIR" "$PKGDEST"
}

sh_version() {
	cat <<-EOF
		   ${bold}${cyan}${APP} v${_VERSION_}${rst}
		   ${APPDESC}
		   ${bold}${orange}Copyright (c) 2019-2025, ${rst}ChiliLinux Development Team ${yellow}<https://chililinux.com> <https://github.com/chililimux>
		   ${bold}${orange}Copyright (c) 2025-2025, ${rst}VoidLinuxBR Development Team ${yellow}<https://www.youtube.com/@voidlinuxbr <https://github.com/voidlinuxbr> <https://t.me/VoidLinuxBrasil>
		   ${bold}${orange}Copyright (c) 2019-2025, ${rst}Vilmar Catafesta ${yellow}<vcatafesta@gmail.com> <https://github.com/vcatafesta>${rst}

		   Este é um software livre: você é livre para alterá-lo e redistribuí-lo.
		   O $APP é disponibilizado para você sob a ${yellow}Licença MIT${black}, e
		   inclui software de código aberto sob uma variedade de outras licenças.
		   Você pode ler instruções sobre como baixar e criar para você mesmo
		   o código fonte específico usado para criar esta cópia.
		   ${red}Este programa vem com absolutamente NENHUMA garantia.${reset}
	EOF
}

usage() {
	printf "%b\n" \
		"${bold}${blue}pkgmake${rst} — utilitário de build para pacotes Void XBPS

${bold}Uso:${reset}
  pkgmake [opções]

${bold}Opções:${reset}
  ${green}-s${reset}, ${green}--syncdeps${reset}                   Instalar depends e makedepends
  ${green}-i${reset}, ${green}--install${reset}                    Instalar pacote após o build
  ${green}-f${reset}, ${green}--force${reset}                      Forçar reinstalação do pacote
  ${green}-q${reset}, ${green}--quiet${reset}                      Silenciar saída dos comandos
  ${green}-v${reset}, ${green}--verbose${reset}                    Mostrar saída dos comandos
      ${green}--gen-key${reset}                    Gerar chave RSA 4096 em formato PEM
      ${green}--privkey${reset} ${yellow}<path>${reset}             Caminho da chave privada PEM (autodetecta se omitido)
      ${green}--sign${reset}                       Assinar o pacote recém-construído após o build
      ${green}--sign-only${reset}                  Assinar pacotes do repositório local (sem build)
      ${green}--reindex${reset}                    Atualizar o índice do repositório local após o build
      ${green}--reindex-only${reset}               Recriar o índice do repositório local e sair
      ${green}--reindex-all${reset}                Assinar todos os pacotes e recriar o índice do repositório local e sair
      ${green}--dedup-repo${reset}                 Remove pacotes duplicados do repositório local, mantém a mais nova
  ${green}-c|--clean${reset}                       Limpar diretórios de trabalho
  ${green}-p|--print-config${reset}                Imprimir configuracao do /etc/pkgmake.conf
  ${green}-k|--pkgdest${reset} ${yellow}<path>${reset}              Diretório local onde os pacotes (.xbps) e o repodata serão gerados
  ${green}  |--packager${reset} ${yellow}<nome>${reset}             Nome Empacotador
  ${green}new ${yellow}<pacote>${reset}                     Criar esqueleto básico de PKGFILE
  ${green}new --from-arch ${yellow}<pacote>${reset}         Importar PKGBUILD do Arch/AUR (requer revisão manual)
  ${green}new --from-voidlinuxbr ${yellow}<pacote>${reset}  Importar template de pacote da Comunidade VoidLinuxBR (requer revisão manual)
  ${green}new --from-void ${yellow}<pacote>${reset}         Importar template de pacote do Void Linux (requer revisão manual)
  ${green}new --from-venom ${yellow}<pacote>${reset}        Importar template de pacote do Venom Linux (requer revisão manual)
  ${green}new --from-alpine ${yellow}<pacote>${reset}       Importar APKBUILD do Alpine Linux (requer revisão manual)
  ${green}new --from-fedora ${yellow}<pacote>${reset}       Importar .spec do Fedora (requer revisão manual)
  ${green}new --from-debian ${yellow}<pacote>${reset}       Importar pacote fonte do Debian (requer revisão manual)
  ${green}-d${reset}, ${green}--debug${reset}                      Ativa modo debug
  ${green}-h${reset}, ${green}--help${reset}                       Mostrar este ajuda

${bold}Exemplos:${reset}
  pkgmake
  pkgmake -s -i
  pkgmake --sign
  pkgmake --sign-only --privkey minha-chave.pem
  pkgmake -q
  pkgmake new nano
"
}

create_repodata() {
	case "$REINDEX_FORCE" in
	0)
		msg "Update repodata (incremental)"
		#   cmd_run xbps-rindex -a "$PKGDEST"/*.xbps
		# -f: sobrescreve a entrada se o mesmo pkgver já estiver no índice
		# (rebuild sem subir pkgrel, ex.: correção de depends)
		cmd_run xbps-rindex -f -a "$PKGDEST/${PKGOUT}"
		;;
	2)
		msg "Update repodata (incremental)"
		#   cmd_run xbps-rindex -a "$PKGDEST"/*.xbps
		shopt -s nullglob
		# -f: atualiza entradas de mesmo pkgver (sem reassinar pacotes)
		cmd_run xbps-rindex -f -a $PKGDEST/*.xbps >/dev/null 2>&1
		;;
	1)
		msg "Recreate repodata (hard reset)"

		# remove estado antigo do repo
		rm -f "$PKGDEST"/*-repodata "$PKGDEST"/*-repodata.sig

		# recria índice vazio
		cmd_run xbps-rindex -r "$PKGDEST"

		#      	# adiciona pacotes UM A UM (igual xbps-src)
		#      	local p
		#      	for p in "$PKGDEST"/*.xbps; do
		#      		[[ -f "$p" ]] || continue
		#      		cmd_run xbps-rindex -a "$p"
		#      	done

		shopt -s nullglob
		cmd_run xbps-rindex -a $PKGDEST/*.xbps
		;;
	*)
		die "REINDEX_FORCE inválido (use 0 ou 1): $REINDEX_FORCE"
		;;
	esac

	# assina o índice (se habilitado)
	if [[ "$SIGNPKG" -eq 1 ]]; then
		ensure_privkey

		local signedby=()
		[[ -n "$PACKAGER" ]] && signedby=(--signedby "$PACKAGER")
		cmd_run xbps-rindex \
			--sign \
			"${signedby[@]}" \
			--privkey "$PRIVKEY" \
			"$PKGDEST"
	fi
}

sign_only() {
	local PKGOUT="$1"

	ensure_privkey

	shopt -s nullglob

	local pkgs
	if ((REINDEX_FORCE)); then
		# modo force: assina TODOS os pacotes
		pkgs=("$PKGDEST"/*.xbps)
	elif [[ -n "${PKGOUT}" ]]; then
		# modo normal: assina só o pacote construido agora
		pkgs=("$PKGDEST/${PKGOUT}")
	else
		# modo normal: assina só os que NÃO têm .sig2
		pkgs=()
		local p
		for p in "$PKGDEST"/*.xbps; do
			[[ -f "$p.sig2" ]] || pkgs+=("$p")
		done
	fi

	msg "Usando chave: $PRIVKEY"
	shopt -u nullglob
	[[ "${#pkgs[@]}" -gt 0 ]] || die "nenhum pacote sem assinar em $PKGDEST"

	for pkg in "${pkgs[@]}"; do
		#		msg "Sign package: $(basename "$pkg")"
		msg "Sign package: $pkg"
		rm -f "$pkg.sig2"
		cmd_run xbps-rindex --sign-pkg --privkey "$PRIVKEY" "$pkg"
	done
}

resolve_conffiles() {
	conf_files_arg=""
	if [[ -n "${backup[*]}" ]]; then
		conf_files_arg="$(printf '%s ' "${backup[@]}")"
		conf_files_arg="${conf_files_arg% }"
	fi

	# testar para ver o resultado
	# xbps-query --property=conf_files pkgmake
}

resolve_fns() {
	# ---- wrappers (somente se o PKGFILE NÃO definiu a função) ----

	# prepare
	if ! pkg_has_fn prepare && pkg_has_fn do_prepare; then
		prepare() { do_prepare "$@"; }
	fi

	# prepare (extract / patch)
	if ! pkg_has_fn prepare && pkg_has_fn do_extract; then
		prepare() { do_extract "$@"; }
	fi

	# build
	if ! pkg_has_fn build && pkg_has_fn do_build; then
		build() { do_build "$@"; }
	fi

	# package / install
	if ! pkg_has_fn package && pkg_has_fn do_install; then
		package() { do_install "$@"; }
	fi

	# fetch: sempre existe, do_fetch sobrescreve
	if pkg_has_fn do_fetch; then
		fetch() { do_fetch "$@"; }
	fi

	# ---- estado final (baseado NO PKGFILE) ----
	# fetch é sempre obrigatório (estilo xbps-src)
	HAS_FETCH=1
	HAS_PREPARE=0
	HAS_BUILD=0
	HAS_PACKAGE=0
	HAS_BUILD_STYLE=0

	pkg_has_fn prepare && HAS_PREPARE=1
	pkg_has_fn do_extract && HAS_PREPARE=1
	pkg_has_fn do_patch && HAS_PREPARE=1

	pkg_has_fn build && HAS_BUILD=1
	pkg_has_fn do_build && HAS_BUILD=1

	pkg_has_fn package && HAS_PACKAGE=1
	pkg_has_fn do_install && HAS_PACKAGE=1

	IS_LOCAL_SOURCE=0
	# declaração explícita
	if [[ "${build_style:-}" == "local" || "${build_style:-}" == "manual-install" ]]; then
		IS_LOCAL_SOURCE=1
		msg "Source local detectado (build_style=${build_style})"
		return 0
	fi

	# fallback implícito
	if [[ -z "${distfiles:-}" && -z "${source:-}" ]]; then
		IS_LOCAL_SOURCE=1
		msg "Source local detectado (distfiles e source vazios)"
		return 0
	fi
}

resolve_pkgdest() {
	local dest

	if [[ -n "$CLI_PKGDEST" ]]; then
		dest="$CLI_PKGDEST"
	elif [[ -n "$PKGDEST" ]]; then
		dest="$PKGDEST"
	else
		die "PKGDEST não definido (use --pkgdest ou /etc/pkgmake.conf)"
	fi

	# BUGFIX: atualiza a global ANTES de validar, senão validate_pkgdest_sanity
	# checa o valor antigo (ex.: vazio) em vez do valor recém-resolvido.
	PKGDEST="$dest"
	validate_pkgdest_sanity

	# absolutiza
	dest="$(readlink -f "$dest" 2>/dev/null || true)"
	[[ -n "$dest" ]] || die "PKGDEST inválido após resolução"

	# cria se não existir
	mkdir -p "$dest" || die "não consegui criar PKGDEST: $dest"

	# testa escrita
	[[ -w "$dest" ]] || die "sem permissão de escrita em PKGDEST: $dest"

	PKGDEST="$dest"
}

resolve_packager() {
	local packager

	if [[ -n "$CLI_PACKAGER" ]]; then
		packager="$CLI_PACKAGER"
	elif [[ -n "$PACKAGER" ]]; then
		packager="$PACKAGER"
	else
		die "PACKAGER não definido (use --packager ou /etc/pkgmake.conf)"
	fi

	# BUGFIX: atualiza a global ANTES de validar, senão validate_packager_sanity
	# checa o valor antigo (ex.: vazio) em vez do --packager recém-passado.
	PACKAGER="$packager"
	validate_packager_sanity
}

resolve_signpkg() {
	if [[ -n "$CLI_SIGNPKG" ]]; then
		SIGNPKG="$CLI_SIGNPKG"
	fi

	case "$SIGNPKG" in
	0 | 1) : ;;
	*)
		die "SIGNPKG inválido (use 0 ou 1): $SIGNPKG"
		;;
	esac
}

resolve_syncdeps() {
	if [[ -n "$CLI_SYNCDEPS" ]]; then
		SYNCDEPS=1
	elif [[ -z "$SYNCDEPS" ]]; then
		SYNCDEPS=0
	fi
}

resolve_verbose() {
	if [[ -n "$CLI_VERBOSE" ]]; then
		VERBOSE="$CLI_VERBOSE"
	fi

	case "$VERBOSE" in
	0 | 1) : ;;
	*)
		die "VERBOSE inválido (use 0 ou 1): $VERBOSE"
		;;
	esac
}

resolve_sources() {
	HAS_GIT_SOURCE=0

	for s in "${source[@]}"; do
		is_git_source "$s" && HAS_GIT_SOURCE=1 || true
	done
}

resolve_reindex() {
	if [[ -n "$CLI_REINDEX" ]]; then
		REINDEX_FORCE=1
	fi

	case "$REINDEX_FORCE" in
	0 | 1) : ;;
	*)
		die "/etc/pkgmake.conf -> REINDEX_FORCE inválido (use 0 ou 1): $REINDEX_FORCE"
		;;
	esac
}

sanitize_pkgfile_vars() {
	# ---- nome do pacote ----
	: "${pkgname:?pkgname não definido no PKGFILE}"
	pkgbase="${pkgbase:-$pkgname}"
	name="${name:-$pkgname}"

	# ---- versão / revisão (Void → Arch) ----
	if [[ -z "${pkgver:-}" && -n "${version:-}" ]]; then
		pkgver="$version"
	fi

	if [[ -z "${pkgrel:-}" && -n "${revision:-}" ]]; then
		pkgrel="$revision"
	fi

	: "${pkgver:=}"
	: "${pkgrel:=}"

	# ---- descrição (Void → Arch) ----
	if [[ -z "${pkgdesc:-}" && -n "${short_desc:-}" ]]; then
		pkgdesc="$short_desc"
	fi
	: "${pkgdesc:=}"

	# ---- source / distfiles (Void → Arch) ----
	if [[ -z "${source:-}" && -n "${distfiles:-}" ]]; then
		source="$distfiles"
	fi

	# garantir array source
	if [[ -z "${source:-}" ]]; then
		source=()
	elif [[ "$(declare -p source 2>/dev/null)" != "declare -a"* ]]; then
		source=("$source")
	fi

	# ---- conf_files / backup (Void → Arch) ----
	if [[ -z "${backup:-}" && -n "${conf_files:-}" ]]; then
		backup="$conf_files"
	fi

	# garantir array backup
	if [[ -z "${backup:-}" ]]; then
		backup=()
	elif [[ "$(declare -p backup 2>/dev/null)" != "declare -a"* ]]; then
		backup=("$backup")
	fi

	# ---- arrays canônicos ----
	declare -p depends &>/dev/null || depends=()
	declare -p provides &>/dev/null || provides=()
	declare -p replaces &>/dev/null || replaces=()
	declare -p conflicts &>/dev/null || conflicts=()
	declare -p makedepends &>/dev/null || makedepends=()
	declare -p license &>/dev/null || license=()
}

if [[ "$1" == "new" ]]; then
	shift
	parse_config
	resolve_packager
	pkgmake_new "$@"
	exit 0
fi

dedup_repo() {
	local old
	local AllOldPackages
	local lretval=1

	msg "Iniciando deduplicação de pacotes no repositório local: ${PKGMAKE_HOST_PKGDEST:-$PKGDEST}"
	AllOldPackages=$(find "$PKGDEST" -type f -iname "*.$PKG_EXT" | sort -Vr | awk -F "$FETCH_RE" 'lista[$1]++')
	for old in $AllOldPackages; do
		msg "${yellow}=>Removendo pacote antigo: [$((++count))] => $(basename "${old}") ${reset}"
		msg "${yellow}=>Removendo pacote antigo: [$((count))] => $(basename "${old}.sig2") ${reset}"
		rm -f "${old}" "${old}".sig2 >/dev/null 2>&-
		lretval=0
	done
	msg "Done!"
	return $lretval
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	-s | --syncdeps)
		CLI_SYNCDEPS=1
		shift
		;;
	-i | --install)
		INSTALLPKG=1
		shift
		;;
	-f | --force)
		FORCEPKG=1
		shift
		;;
	-v | --verbose)
		CLI_VERBOSE=1
		shift
		;;
	-V | --version)
		sh_version
		exit 0
		;;
	-q | --quiet)
		CLI_VERBOSE=0
		shift
		;;
	--gen-key)
		GEN_KEY=1
		shift
		;;
	--sign)
		CLI_SIGNPKG=1
		shift
		;;
	--sign-only)
		SIGN_ONLY=1
		shift
		;;
	--reindex)
		CLI_REINDEX=1
		shift
		;;
	--reindex-only)
		REINDEX_ONLY=true
		shift
		;;
	--reindex-all)
		REINDEX_ALL=true
		shift
		;;
	--privkey)
		if [[ $# -lt 2 || "$2" == -* ]]; then
			die "opção '$1' requer um argumento (caminho da chave)"
		fi
		CLI_PRIVKEY="$2"
		shift 2
		;;
	-c | --clean)
		clean
		exit 0
		;;
	--dedup-repo)
		parse_config
		dedup_repo
		REINDEX_FORCE=1
		create_repodata
		exit 0
		;;
	-p | --print-config)
		parse_config
		print_config
		exit 0
		;;
	-k | --pkgdest)
		if [[ $# -lt 2 || "$2" == -* ]]; then
			die "opção '$1' requer um argumento (diretório de destino)"
		fi
		CLI_PKGDEST="$2"
		shift 2
		;;
	--packager)
		if [[ -z "$2" || "$2" == -* ]]; then
			die "opção '--packager' requer um argumento: 'Nome Completo <email>'"
		fi
		CLI_PACKAGER="$2"
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	-d | --debug)
		DEBUG=1
		set -x
		shift
		;;
	*) die "opção inválida: $1" ;;
	esac
done

parse_config
# --privkey da linha de comando tem prioridade sobre o PRIVKEY do /etc/pkgmake.conf
[[ -n "$CLI_PRIVKEY" ]] && PRIVKEY="$CLI_PRIVKEY"

if ((GEN_KEY)); then
	gen_key
	exit 0
fi

resolve_reindex
resolve_pkgdest # BUGFIX: garante PKGDEST válido também nos atalhos --sign-only/--reindex-only/--reindex-all

if $REINDEX_ALL; then
	REINDEX_FORCE=1
	dedup_repo
	SIGN_ONLY=1
	sign_only
	create_repodata
	exit 0
fi

if $REINDEX_ONLY; then
	#	REINDEX_FORCE=1
	REINDEX_FORCE=2
	dedup_repo
	create_repodata
	exit 0
fi

if ((SIGN_ONLY)); then
	sign_only
	exit 0
fi

resolve_syncdeps
resolve_signpkg
resolve_verbose
# resolve_pkgdest já foi chamado mais acima (antes dos atalhos --sign-only/--reindex-*)
resolve_packager
load_pkgfile
sanitize_pkgfile_vars
resolve_sources
normalize_deps
check_deps_repo
normalize_dep_patterns
resolve_fns
validate_config # validação FINAL, com tudo resolvido
#sync_deps
run_all
