export TEXTDOMAINDIR=/usr/share/locale
export TEXTDOMAIN=pkgmake

#debug
: "${rst=$(tput sgr0)}"
: "${red=$(tput bold)$(tput setaf 196)}"
: "${green=$(tput bold)$(tput setaf 2)}"
: "${pink=$(tput setaf 5)}"
export PS4='${red}${0##*/}${green}[$FUNCNAME]${pink}[$LINENO]${rst}'
#set -x
[[ " $* " =~ [[:space:]](-d|--debug)[[:space:]] ]] && DEBUG=1 && set -x
set -o pipefail

#system
declare APP="${0##*/}"
declare _VERSION_="1.10.29-20261029"
declare APPDESC="$APP - Wraper for xbps-create"
declare distro="$(uname -n)"
declare DEPENDENCIES=(tput)
declare FETCH_RE='-[^-]+[0-9]+[^.]*.xbps$'
declare PKG_EXT='xbps'

WORKDIR="$PWD"
SRCDIR="$WORKDIR/src"
PKGDIR="$WORKDIR/pkg"

# como no makepkg do Arch: com CDPATH definido, 'cd' imprime o caminho
# e suja saídas capturadas (ex.: pkgver())
unset CDPATH
ARCH="$(uname -m)"
# como no makepkg do Arch: PKGBUILDs usam $CARCH (ex.: case "$CARCH" in x86_64)...)
export CARCH="${CARCH:-$ARCH}"

SYNCDEPS=0
CLI_SYNCDEPS=""

INSTALLPKG=0
