#!/usr/bin/env bash
# pkgmake-docker - roda o pkgmake dentro de um container Void Linux limpo
#
# Uso (na pasta do PKGFILE, igual ao pkgmake):
#   pkgmake-docker -s
#   pkgmake-docker --build-image     # (re)constrói a imagem e sai
#
# Variáveis:
#   PKGMAKE_IMAGE         imagem a usar   (padrão: voidbr/pkgmake-builder:latest)
#   PKGMAKE_CACHE_VOLUME  volume do cache do xbps (padrão: pkgmake-xbps-cache)
set -euo pipefail

red=$'\e[1;31m'
green=$'\e[1;32m'
yellow=$'\e[1;33m'
blue=$'\e[1;34m'
cyan=$'\e[1;36m'
bold=$'\e[1m'
rst=$'\e[0m'
reset="$rst"

msg() { echo -e "${cyan}==> $*${rst}"; }
die() {
	echo -e "${red}ERRO: $*${rst}" >&2
	exit 1
}

IMAGE="${PKGMAKE_IMAGE:-voidbr/pkgmake-builder:latest}"
CACHE_VOLUME="${PKGMAKE_CACHE_VOLUME:-pkgmake-xbps-cache}"

usage() {
	printf "%b\n" \
		"${bold}${blue}pkgmake-docker${reset} — roda o pkgmake dentro de um container Void Linux limpo

${bold}Uso:${reset}
  pkgmake-docker [opções] [opções do pkgmake]
  (rode na pasta do PKGFILE/PKGBUILD, igual ao pkgmake)

${bold}Opções do pkgmake-docker:${reset}
  ${green}-h${reset}, ${green}--help${reset}                       Mostrar esta ajuda
      ${green}--build-image${reset}                (Re)construir a imagem docker e sair
  ${green}-k${reset}, ${green}--pkgdest${reset} ${yellow}<path>${reset}             Diretório local onde os pacotes (.xbps) e o repodata serão gerados
      ${green}--sign${reset}                       Assinar o pacote após o build
      ${green}--privkey${reset} ${yellow}<path>${reset}             Caminho da chave privada PEM (se não existir, oferece criar)

${bold}Opções do pkgmake:${reset}
  Todas as outras opções são repassadas para o pkgmake dentro do container
  (ex.: ${green}-s${reset}, ${green}-i${reset}, ${green}-f${reset}, ${green}-v${reset}, ${green}--reindex${reset}). Veja: ${green}pkgmake --help${reset}

${bold}Configuração:${reset}
  ${yellow}/etc/pkgmake.conf${reset} é obrigatório no host e é montado (somente leitura) no container.
  PKGDEST, PACKAGER, SIGNPKG e PRIVKEY são lidos dele; ${green}-k${reset}, ${green}--sign${reset} e ${green}--privkey${reset} têm prioridade.

${bold}Variáveis de ambiente:${reset}
  ${yellow}PKGMAKE_IMAGE${reset}            Imagem a usar (padrão: ${cyan}voidbr/pkgmake-builder:latest${reset})
  ${yellow}PKGMAKE_CACHE_VOLUME${reset}     Volume do cache do xbps (padrão: ${cyan}pkgmake-xbps-cache${reset})
  ${yellow}GH_TOKEN${reset}                 Token do GitHub repassado ao container para clonar repositórios privados

${bold}Exemplos:${reset}
  ${cyan}pkgmake-docker -s${reset}                    Build instalando as dependências
  ${cyan}pkgmake-docker -s --sign${reset}             Build e assinatura do pacote
  ${cyan}pkgmake-docker -s -k ~/repodir${reset}       Build com destino diferente do /etc/pkgmake.conf
  ${cyan}pkgmake-docker --build-image${reset}         Reconstruir a imagem"
}

# ajuda antes de qualquer verificação (docker, Dockerfile, /etc/pkgmake.conf)
for a in "$@"; do
	case "$a" in
	-h | --help)
		usage
		exit 0
		;;
	esac
done

# pkgmake e arquivos de suporte do host (mesmo layout no repositório e instalado)
bindir="$(dirname "$(readlink -f "$0")")"
host_pkgmake="$bindir/pkgmake"

# pkgmake: o que está ao lado do script; se não houver, o do PATH
[[ -x "$host_pkgmake" ]] || host_pkgmake="$(command -v pkgmake || true)"
[[ -x "$host_pkgmake" ]] || die "pkgmake não encontrado"

# arquivos do container: ao lado do script (repositório ou make install),
# depois /usr/local e /usr
sharedir=""
for d in "$bindir/../share/pkgmake" /usr/local/share/pkgmake /usr/share/pkgmake; do
	if [[ -f "$d/docker/Dockerfile" ]]; then
		sharedir="$(readlink -f "$d")"
		break
	fi
done
[[ -n "$sharedir" ]] ||
	die "Dockerfile não encontrado em $bindir/../share/pkgmake/docker, /usr/local/share/pkgmake/docker nem /usr/share/pkgmake/docker"
msg "Dockerfile: ${sharedir}/docker/Dockerfile"
msg "pkgmake:    ${host_pkgmake}"
command -v docker >/dev/null 2>&1 || die "docker não encontrado"

build_image() {
	msg "Construindo imagem $IMAGE"
	docker build -t "$IMAGE" "$sharedir/docker"
}

# configuração do host: PKGDEST, PACKAGER, SIGNPKG, PRIVKEY
PKGDEST=""
PACKAGER=""
SIGNPKG=0
PRIVKEY=""
# sem /etc/pkgmake.conf no host não há build: o container usa o mesmo arquivo
[[ -f /etc/pkgmake.conf ]] || die "/etc/pkgmake.conf não encontrado no host"
source /etc/pkgmake.conf

args=()
while (($#)); do
	case "$1" in
	--build-image)
		build_image
		exit 0
		;;
	-k | --pkgdest)
		[[ $# -ge 2 ]] || die "opção '$1' requer um argumento"
		PKGDEST="$2"
		shift 2
		;;
	--sign)
		SIGNPKG=1
		shift
		;;
	--privkey)
		[[ $# -ge 2 ]] || die "opção '$1' requer um argumento"
		PRIVKEY="$2"
		shift 2
		;;
	*)
		args+=("$1")
		shift
		;;
	esac
done

[[ -n "$PKGDEST" ]] || die "PKGDEST não definido (use -k ou /etc/pkgmake.conf)"
mkdir -p "$PKGDEST"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
	build_image
fi

run_opts=(--rm -i)
[[ -t 0 && -t 1 ]] && run_opts+=(-t)
run_opts+=(
	-e "PKGMAKE_UID=$(id -u)"
	-e "PKGMAKE_GID=$(id -g)"
	-e "PKGMAKE_HOST_PKGDEST=$(readlink -f "$PKGDEST")"
	-v "$PWD:/build"
	-w /build
	-v "$(readlink -f "$PKGDEST"):/repo"
	-v "$host_pkgmake:/usr/bin/pkgmake:ro"
	-v "$sharedir:/usr/share/pkgmake:ro"
	-v "$CACHE_VOLUME:/var/cache/xbps"
)

# mesmo /etc/pkgmake.conf do host (somente leitura); PKGDEST, PACKAGER e a
# chave continuam indo pela linha de comando (-k /repo, --packager, --privkey),
# então os caminhos do host que estão no arquivo não atrapalham.
run_opts+=(-v /etc/pkgmake.conf:/etc/pkgmake.conf:ro)

# repassa o GH_TOKEN (só se existir no host) para clonar repositórios privados
[[ -n "${GH_TOKEN:-}" ]] && run_opts+=(-e GH_TOKEN)

pm_args=(-k /repo)
[[ -n "$PACKAGER" ]] && pm_args+=(--packager "$PACKAGER")

# assinatura: a chave entra só como leitura, nunca na imagem
if [[ "$SIGNPKG" == 1 ]]; then
	# sem PRIVKEY: procura nos mesmos lugares que o pkgmake
	if [[ -z "$PRIVKEY" ]]; then
		for k in "$HOME/.ssh/private.pem" "$HOME/.ssh/privkey.pem" \
			"$HOME/.gnupg/private.pem" "$HOME/.gnupg/privkey.pem"; do
			[[ -f "$k" ]] && PRIVKEY="$k" && break
		done
		: "${PRIVKEY:=$HOME/.ssh/privkey.pem}"
	fi
	# chave inexistente: cria aqui no host (dentro do container ela se perderia)
	if [[ ! -f "$PRIVKEY" ]]; then
		[[ -t 0 && -t 1 ]] ||
			die "chave privada não encontrada: $PRIVKEY (crie com: pkgmake --gen-key)"
		echo -e "${red}chave privada não encontrada: $PRIVKEY${rst}"
		echo -e "${red}uma chave nova gera assinatura nova: as máquinas que já usam o seu repositório vão precisar aceitar a nova chave pública${rst}"
		read -r -p "Criar a chave '$PRIVKEY' agora? [S/n]"
		[[ -z "$REPLY" || "${REPLY^}" == [SY] ]] ||
			die "assinatura cancelada: chave não encontrada: $PRIVKEY"
		"$host_pkgmake" --gen-key --privkey "$PRIVKEY"
		[[ -f "$PRIVKEY" ]] || die "não consegui criar a chave: $PRIVKEY"
	fi
	run_opts+=(-v "$(readlink -f "$PRIVKEY"):/keys/privkey.pem:ro")
	pm_args+=(--sign --privkey /keys/privkey.pem)
fi

# repositórios: os mesmos do /etc/xbps.d/ da máquina (só os http/https;
# os locais, como o PKGDEST, não existem dentro do container)
repos_conf="$(mktemp)"
trap 'rm -f "$repos_conf"' EXIT
grep -hE '^[[:space:]]*repository=https?://' /etc/xbps.d/*.conf 2>/dev/null >"$repos_conf" || true
chmod 644 "$repos_conf"
run_opts+=(-v "$repos_conf:/etc/xbps.d/10-host-repos.conf:ro")

msg "Build em container ($IMAGE)"
docker run "${run_opts[@]}" "$IMAGE" "${pm_args[@]}" "${args[@]}"
