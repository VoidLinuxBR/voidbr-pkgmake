pkgname=voidbr-pkgmake
pkgdesc="Make pkg like tool for XBPS"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()
replaces=()
conflicts=()
arch=('any')
license=('MIT')
url="https://github.com/voidlinuxbr/$pkgname"
source=("git+${url}.git")
md5sums=('SKIP')
depends=(
	base-devel
	bash
	curl
	git
	xbps
	xbps-triggers
	coreutils
	ncurses
	ncurses-devel
	cmake
	docker
	docker-buildx
	jq
	fakeroot
	openssh
	shfmt
)
#conf_files=( /etc/pkgmake.conf /etc/vilmar.conf )
backup=(/etc/pkgmake.conf)

package() {
	local dirs=("usr" "etc" "opt")
	#   echo "DESTDIR=$DESTDIR"
	#   echo "pkgdir=$pkgdir"
	#   echo "srcdir=$srcdir"
	#   echo "_pkgsrc=$_pkgsrc"

	cd ${srcdir}/${pkgname}
	for dir in "${dirs[@]}"; do
		if [ -d "${_pkgsrc}/${dir}" ]; then
			cp -a "${_pkgsrc}/${dir}" "$DESTDIR/"
		fi
	done

	#	install -Dm644 etc/pkgmake.conf $DESTDIR/etc/pkgmake.conf.new-${pkgver}-${pkgrel}
	install -Dm644 etc/pkgmake.conf $DESTDIR/etc/pkgmake.conf.new
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	# grupo docker: o pkgmake-docker precisa rodar o docker sem sudo
	getent group docker >/dev/null 2>&1 || groupadd -r docker
	if [ -n "$user" ]; then
		if id -nG "$user" | grep -qw docker; then
			log "usuário '$user' já está no grupo docker"
		else
			usermod -aG docker "$user"
			log "usuário '$user' adicionado ao grupo docker (saia e entre de novo na sessão, ou rode: newgrp docker)"
		fi
	fi

	# serviço docker: dentro de chroot (ex.: geração de ISO) não mexe no serviço
	if [ "$(stat -c %d:%i /)" != "$(stat -c %d:%i /proc/1/root/. 2>/dev/null)" ]; then
		log "chroot detectado: ative o docker depois com: vservice add docker"
	elif sv status docker 2>/dev/null | grep -q '^run:'; then
		log "serviço docker ativo"
	elif [ -t 0 ]; then
		printf "%s" "${YELLOW}Serviço docker não está ativo. Ativar e subir agora? [S/n] ${RESET}"
		read -r resp || resp=n
		case "$resp" in
		"" | [SsYy]*)
			vservice add docker
			if sv status docker 2>/dev/null | grep -q '^run:'; then
				log "serviço docker ativo"
			else
				log "serviço docker não subiu; verifique com: sv status docker"
			fi
			;;
		*)
			log "serviço docker não ativado; para ativar: vservice add docker"
			;;
		esac
	else
		log "serviço docker não está ativo; para ativar: vservice add docker"
	fi
}

pre_upgrade() {
	log "Iniciando upgrade"
}

# o INSTALL gerado pelo pkgmake só chama post_upgrade no upgrade
post_upgrade() {
	post_install
}
